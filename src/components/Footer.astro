---
const today = new Date();
---

<footer class="site-footer">
	<div class="footer-inner">&copy; {today.getFullYear()} Quan Zhou</div>
</footer>

<style>
	.site-footer {
		margin-top: auto;
		background: #f5f5f5;
		color: #525252;
		font-family: var(--font-heading);
		font-size: 1rem;
		line-height: 1.5;
		text-align: center;
	}

	.footer-inner {
		padding: 1.5rem;
		background: #e5e5e5;
		text-align: center;
	}

	@media (prefers-color-scheme: dark) {
		.site-footer {
			background: #525252;
			color: #e5e5e5;
		}

		.footer-inner {
			background: #404040;
		}
	}
</style>
