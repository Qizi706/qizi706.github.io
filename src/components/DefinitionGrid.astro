---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'dl'>, 'class'> {
	as?: 'dl' | 'div';
	variant?: 'plain' | 'outlined' | 'elevated' | 'ledger';
	columns?: 1 | 2 | 3;
	collapseAt?: 'none' | '520' | '620' | '720';
	class?: string;
}

const {
	as: Tag = 'dl',
	variant = 'plain',
	columns = 2,
	collapseAt = 'none',
	class: className,
	...attributes
} = Astro.props;
---

<Tag
	class:list={[
		'definition-grid',
		`definition-grid--${variant}`,
		`definition-grid--columns-${columns}`,
		{ [`definition-grid--collapse-${collapseAt}`]: collapseAt !== 'none' },
		className,
	]}
	{...attributes}
>
	<slot />
</Tag>

<style>
	.definition-grid {
		display: grid;
		gap: 0.75rem;
		margin: 0;
	}

	.definition-grid--columns-1 {
		grid-template-columns: 1fr;
	}

	.definition-grid--columns-2 {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.definition-grid--columns-3 {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.definition-grid--outlined > :global(div),
	.definition-grid--elevated > :global(div) {
		border-radius: var(--card-radius);
		background: #f8fafc;
	}

	.definition-grid--outlined > :global(div) {
		padding: 0.85rem 0.95rem;
		border: 1px solid #dbe3ec;
	}

	.definition-grid--elevated {
		gap: 0.55rem;
		margin: 0.8rem 0;
	}

	.definition-grid--elevated > :global(div) {
		padding: 0.55rem 0.65rem;
		border: 0;
		background: rgb(248 250 252 / 60%);
		box-shadow: var(--elevated-card-shadow);
	}

	.definition-grid--ledger {
		gap: 0;
		border-top: 1px solid rgb(var(--gray-light));
		border-bottom: 1px solid rgb(var(--gray-light));
		font-size: 0.72rem;
	}

	.definition-grid--ledger > :global(div) {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr);
		gap: 0.65rem;
		padding: 0.5rem 0.65rem;
		border-bottom: 1px dashed rgb(var(--gray-light));
	}

	.definition-grid--ledger > :global(div:nth-child(odd)) {
		border-right: 1px dashed rgb(var(--gray-light));
	}

	.definition-grid--ledger > :global(div:nth-last-child(-n + 2)) {
		border-bottom: 0;
	}

	.definition-grid--ledger :global(dt),
	.definition-grid--ledger :global(dd) {
		margin: 0;
	}

	.definition-grid--ledger :global(dt) {
		color: var(--accent);
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.definition-grid--ledger :global(dd) {
		color: rgb(var(--gray));
	}

	@media (max-width: 720px) {
		.definition-grid--collapse-720 {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 620px) {
		.definition-grid--collapse-620 {
			grid-template-columns: 1fr;
		}

		.definition-grid--ledger.definition-grid--collapse-620 > :global(div),
		.definition-grid--ledger.definition-grid--collapse-620 > :global(div:nth-child(odd)) {
			grid-template-columns: 5.8rem minmax(0, 1fr);
			border-right: 0;
			border-bottom: 1px dashed rgb(var(--gray-light));
		}

		.definition-grid--ledger.definition-grid--collapse-620 > :global(div:last-child) {
			border-bottom: 0;
		}
	}

	@media (max-width: 520px) {
		.definition-grid--collapse-520 {
			grid-template-columns: 1fr;
		}
	}
</style>
