---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const linkURL = href ? new URL(href, Astro.url) : undefined;
const linkPath = linkURL?.pathname.replace(/\/+$/, '') || '/';
const isInternal = linkURL?.origin === Astro.url.origin;
const isCurrentPage = isInternal && pathname === linkPath;
const isActive =
	isInternal && (isCurrentPage || (linkPath !== '/' && pathname.startsWith(`${linkPath}/`)));
---

<a
	href={href}
	class:list={[className, { active: isActive }]}
	aria-current={isCurrentPage ? 'page' : undefined}
	{...props}
>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		color: inherit;
		text-decoration: none;
		text-underline-offset: 0.25em;
	}
	a.active {
		font-weight: 600;
		text-decoration: underline;
	}
	a:hover {
		text-decoration: underline;
	}
	a:focus-visible {
		border-radius: 2px;
		outline: 2px solid var(--accent, #3730a3);
		outline-offset: 3px;
	}
</style>
