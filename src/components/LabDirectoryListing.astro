---
import { getLabArtifactDisplayHref, getLabDirectoryHref } from '../utils/lab-artifacts.mjs';

interface DirectoryEntry {
	kind: 'directory';
	name: string;
	path: string;
	modified?: string;
}

interface FileEntry {
	kind: 'file';
	name: string;
	path: string;
	modified: string;
	size: number;
	viewable: boolean;
}

interface Props {
	labName: string;
	entries: Array<DirectoryEntry | FileEntry>;
	parentHref: string;
}

const { labName, entries, parentHref } = Astro.props;
const nameColumnWidth = 51;
const sizeColumnWidth = 20;

function getEntryHref(entry: DirectoryEntry | FileEntry): string {
	if (entry.kind === 'directory') return getLabDirectoryHref(labName, entry.path);
	return getLabArtifactDisplayHref(labName, entry.path);
}

function getEntryLabel(entry: DirectoryEntry | FileEntry): string {
	return entry.name + (entry.kind === 'directory' ? '/' : '');
}

function getNamePadding(label: string): string {
	return ' '.repeat(Math.max(1, nameColumnWidth - label.length));
}

function getSizeColumn(entry: DirectoryEntry | FileEntry): string {
	const value = entry.kind === 'directory' ? '-' : String(entry.size);
	return value.padStart(sizeColumnWidth, ' ');
}

function escapeHtml(value: string): string {
	return value
		.replaceAll('&', '&amp;')
		.replaceAll('<', '&lt;')
		.replaceAll('>', '&gt;')
		.replaceAll('"', '&quot;');
}

const listingHtml = [
	`<a href="${escapeHtml(parentHref)}">../</a>`,
	...entries.map((entry) => {
		const label = getEntryLabel(entry);
		return `<a href="${escapeHtml(getEntryHref(entry))}">${escapeHtml(label)}</a>${getNamePadding(label)}${entry.modified ?? ''}${getSizeColumn(entry)}`;
	}),
].join('\n');
---

<pre class="lab-directory-code" set:html={listingHtml} />

<style>
	.lab-directory-code {
		margin: 0;
		padding: 0.8rem 1rem;
	}
</style>
