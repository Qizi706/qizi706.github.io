---
import type { LabUnit } from '../data/lab-roadmap';

interface Props {
	units: LabUnit[];
	compact?: boolean;
	label?: string;
}

const { units, compact = false, label = 'Lab 模块路线' } = Astro.props;
const statusLabels = {
	done: '已通过',
	active: '当前',
	pending: '待解锁',
	optional: '进阶',
};
---

<ol class:list={['roadmap-route', { 'roadmap-route--compact': compact }]} aria-label={label}>
	{
		units.map((unit) => (
			<li class:list={['roadmap-unit', `is-${unit.status}`]}>
				<header>
					<h3>
						{unit.id} · {unit.title}
					</h3>
					<p class="roadmap-unit__details">
						<strong>预计：</strong>
						{unit.duration} · <strong>状态：</strong>
						{statusLabels[unit.status]}
					</p>
				</header>

				<p class="roadmap-unit__question">{unit.question}</p>

				{!compact && (
					<dl class="roadmap-unit__contract">
						<dt>Prerequisite</dt>
						<dd>{unit.dependsOn}</dd>
						<dt>Work</dt>
						<dd>{unit.work}</dd>
						<dt>Artifact</dt>
						<dd>{unit.artifact}</dd>
						<dt>Checkoff</dt>
						<dd>{unit.acceptance}</dd>
					</dl>
				)}

				{!compact && unit.parts && (
					<ol class="roadmap-parts" aria-label={`${unit.id} 子任务`}>
						{unit.parts.map((part) => (
							<li>
								<strong>
									{part.id} · {part.title}
								</strong>
								<span> — {part.checkoff}</span>
								<span>（{statusLabels[part.status]}）</span>
							</li>
						))}
					</ol>
				)}

				{compact ? (
					<p class="roadmap-unit__gate">
						<strong>Gate：</strong>
						{unit.acceptance}
					</p>
				) : (
					<p class="roadmap-unit__next">
						<strong>Unlocks：</strong>
						{unit.unlocks} {unit.href && <a href={unit.href}>打开材料 →</a>}
					</p>
				)}
			</li>
		))
	}
</ol>

<style>
	.roadmap-route {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}

	.roadmap-unit {
		padding: 1rem 0;
		border-top: 1px solid #e2e8f0;
	}

	.roadmap-unit:first-child {
		border-top-color: #cbd5e1;
	}

	.roadmap-unit h3 {
		margin: 0;
	}

	.roadmap-unit__details {
		margin: 0.25rem 0 0;
		color: #64748b;
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.roadmap-unit__details strong {
		color: #475569;
	}

	.roadmap-unit.is-active .roadmap-unit__details {
		color: var(--accent);
	}

	.roadmap-unit h3 {
		font-size: 1.05rem;
	}

	.roadmap-unit__question {
		margin: 0.55rem 0;
		color: #334155;
		line-height: 1.65;
	}

	.roadmap-unit__contract {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr);
		gap: 0.25rem 0.8rem;
		margin: 0.7rem 0 0;
	}

	.roadmap-unit__contract dt {
		color: #64748b;
		font-size: 0.86rem;
		font-weight: 700;
	}

	.roadmap-unit__contract dd {
		margin: 0;
		color: #475569;
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.roadmap-parts {
		margin: 0.75rem 0 0;
		padding-left: 1.35rem;
		color: #475569;
		font-size: 0.88rem;
		line-height: 1.65;
	}

	.roadmap-parts li {
		margin: 0.25rem 0;
	}

	.roadmap-parts span {
		color: #64748b;
	}

	.roadmap-unit__next,
	.roadmap-unit__gate {
		margin: 0.65rem 0 0;
		color: #64748b;
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.roadmap-unit__next a {
		margin-left: 0.35rem;
	}

	.roadmap-route--compact .roadmap-unit {
		padding: 0.7rem 0;
	}

	.roadmap-route--compact .roadmap-unit__question {
		margin: 0.35rem 0 0;
		font-size: 0.95rem;
	}

	.roadmap-route--compact .roadmap-unit__gate {
		margin-top: 0.25rem;
	}

	@media (max-width: 560px) {
		.roadmap-unit__contract {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}

		.roadmap-unit__contract dd + dt {
			margin-top: 0.4rem;
		}
	}
</style>
