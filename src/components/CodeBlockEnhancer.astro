<script>
	type CodeTheme = 'light' | 'dark';

	const themeStorageKey = 'code-theme';

	const getCodeTheme = (): CodeTheme => {
		try {
			return localStorage.getItem(themeStorageKey) === 'dark' ? 'dark' : 'light';
		} catch {
			return 'light';
		}
	};

	const applyCodeTheme = (theme: CodeTheme) => {
		document.documentElement.dataset.codeTheme = theme;

		document.querySelectorAll<HTMLButtonElement>('.code-theme-toggle').forEach((toggle) => {
			const isDark = theme === 'dark';
			toggle.setAttribute('aria-checked', String(isDark));
			toggle.setAttribute('aria-label', isDark ? '切换为亮色代码主题' : '切换为暗色代码主题');
			toggle.title = isDark ? 'One Light' : 'One Dark';
		});
	};

	const enhanceCodeBlocks = () => {
		document
			.querySelectorAll<HTMLPreElement>('.prose pre[class*="language-"]:not(.mermaid)')
			.forEach((pre) => {
				if (pre.closest('.slideshow, .code-card, .note')) return;
				if (pre.dataset.codeBlockEnhanced === 'true') return;

				const code = pre.querySelector<HTMLElement>(':scope > code');
				if (!code) return;

				pre.dataset.codeBlockEnhanced = 'true';

				const shell = document.createElement('div');
				const actions = document.createElement('div');
				const themeToggle = document.createElement('button');
				const body = document.createElement('div');

				shell.className = 'code-block-shell';
				actions.className = 'code-block-actions';
				themeToggle.className = 'code-theme-toggle';
				themeToggle.type = 'button';
				themeToggle.setAttribute('role', 'switch');
				themeToggle.innerHTML = `
					<span class="code-theme-icon code-theme-icon--light" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							<circle cx="12" cy="12" r="3.5"></circle>
							<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
						</svg>
					</span>
					<span class="code-theme-icon code-theme-icon--dark" aria-hidden="true">
						<svg viewBox="0 0 24 24" focusable="false">
							<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
						</svg>
					</span>
					<span class="code-theme-thumb" aria-hidden="true"></span>
				`;
				body.className = 'code-block-body';

				themeToggle.addEventListener('click', () => {
					const nextTheme: CodeTheme =
						document.documentElement.dataset.codeTheme === 'dark' ? 'light' : 'dark';

					try {
						localStorage.setItem(themeStorageKey, nextTheme);
					} catch {
						// Theme switching still works when storage is unavailable.
					}

					applyCodeTheme(nextTheme);
				});

				pre.before(shell);
				actions.append(themeToggle);
				body.append(pre);
				shell.append(actions, body);
			});

		applyCodeTheme(getCodeTheme());
	};

	enhanceCodeBlocks();
	document.addEventListener('astro:page-load', enhanceCodeBlocks);
</script>
