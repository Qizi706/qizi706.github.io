---
import DisclosureCard from './DisclosureCard.astro';

interface Props {
	period: string;
	title: string;
	status?: 'pending' | 'active' | 'done';
	open?: boolean;
}

const { period, title, status = 'pending', open = false } = Astro.props;
const statusLabel = status === 'done' ? '已完成' : status === 'active' ? '进行中' : '待开始';
---

<DisclosureCard class={`learning-stage is-${status}`} surface="elevated" {open}>
	<Fragment slot="summary">
		<span class="summary-main">
			<span class="period">{period}</span>
			<strong>{title}</strong>
		</span>
		<span class:list={['status', `is-${status}`]}>{statusLabel}</span>
	</Fragment>
	<div class="stage-body">
		<slot />
	</div>
</DisclosureCard>

<style>
	.summary-main {
		display: flex;
		flex: 1;
		align-items: baseline;
		gap: 0.75rem;
		min-width: 0;
	}

	.period,
	.status {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 400;
	}

	.period {
		color: rgb(var(--gray));
		white-space: nowrap;
	}

	strong {
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.status {
		flex: 0 0 auto;
		padding: 0.08rem 0.4rem;
		border: 1px solid currentColor;
		border-radius: var(--card-radius);
		white-space: nowrap;
	}

	.status.is-done {
		color: #15803d;
	}

	.status.is-active {
		color: var(--accent);
	}

	.status.is-pending {
		color: rgb(var(--gray));
	}

	.stage-body {
		padding: 0 1rem 1rem;
	}

	@media (max-width: 620px) {
		.summary-main {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
