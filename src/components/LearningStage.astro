---
interface Props {
	period: string;
	title: string;
	status?: 'pending' | 'active' | 'done';
	open?: boolean;
}

const { period, title, status = 'pending', open = false } = Astro.props;
const statusLabel = status === 'done' ? '已完成' : status === 'active' ? '进行中' : '待开始';
---

<details class:list={['learning-stage', `is-${status}`]} {open}>
	<summary>
		<span class="summary-main">
			<span class="period">{period}</span>
			<strong>{title}</strong>
		</span>
		<span class="status">{statusLabel}</span>
	</summary>
	<div class="stage-body">
		<slot />
	</div>
</details>

<style>
	.learning-stage {
		margin: 0.8rem 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: var(--card-radius);
		background: rgb(255 255 255 / 28%);
	}

	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.8rem 0.95rem;
		cursor: pointer;
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before {
		content: '>';
		flex: 0 0 auto;
		color: var(--accent);
		font-family: var(--font-mono);
	}

	.learning-stage[open] summary::before {
		content: 'v';
	}

	.summary-main {
		display: flex;
		flex: 1;
		align-items: baseline;
		gap: 0.75rem;
		min-width: 0;
	}

	.period,
	.status {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 400;
	}

	.period {
		color: rgb(var(--gray));
		white-space: nowrap;
	}

	strong {
		font-family: var(--font-heading);
		font-weight: 700;
	}

	.status {
		flex: 0 0 auto;
		padding: 0.08rem 0.4rem;
		border: 1px solid currentColor;
		border-radius: var(--card-radius);
		white-space: nowrap;
	}

	.is-done .status {
		color: #15803d;
	}

	.is-active .status {
		color: var(--accent);
	}

	.is-pending .status {
		color: rgb(var(--gray));
	}

	.stage-body {
		padding: 0 1rem 1rem;
		border-top: 1px dashed rgb(var(--gray-light));
	}

	@media (max-width: 620px) {
		summary {
			align-items: flex-start;
		}

		.summary-main {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
