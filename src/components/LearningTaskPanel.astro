---
interface Reference {
	label: string;
	href: string;
}

interface Task {
	id: string;
	title: string;
	period: string;
	objective: string;
	question: string;
	prediction: string;
	preRead: Reference[];
	artifact: string;
	acceptance: string;
	steps: string[];
	nextDecision: string;
}

interface Props {
	task: Task;
	documentHref: string;
	anchorId?: string;
}

const { task, documentHref, anchorId = 'current' } = Astro.props;
---

<section id={anchorId} class="learning-task-panel">
	<header>
		<h2>现在跟做：{task.id} · {task.title}</h2>
	</header>

	<dl class="learning-task-panel__summary">
		<dt>时间</dt><dd>{task.period}</dd>
		<dt>唯一目标</dt><dd>{task.objective}</dd>
		<dt>问题</dt><dd>{task.question}</dd>
		<dt>运行前预测</dt><dd>{task.prediction}</dd>
		<dt>Artifact</dt><dd>{task.artifact}</dd>
		<dt>Acceptance</dt><dd>{task.acceptance}</dd>
	</dl>

	<h3>前置阅读 · 15 min</h3>
	<ul>
		{
			task.preRead.map((reference) => (
				<li>
					<a href={reference.href}>{reference.label}</a>
				</li>
			))
		}
	</ul>
	<p>每篇只记录一句：它确认或修正了哪条预测。<a href={documentHref}>打开当前工作表 →</a></p>

	<h3>执行顺序</h3>
	<ol>
		{task.steps.map((step) => <li>{step}</li>)}
	</ol>
	<p><strong>下一步判断：</strong>{task.nextDecision}</p>
</section>

<style>
	.learning-task-panel {
		margin: 2rem 0;
		padding: 2rem 0;
		border-top: 1px solid #cbd5e1;
		border-bottom: 1px solid #cbd5e1;
		scroll-margin-top: 4.5rem;
	}

	.learning-task-panel h2 {
		margin: 0;
		font-size: 1.35rem;
	}

	.learning-task-panel__summary {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr);
		gap: 0.3rem 0.8rem;
		margin-top: 1rem;
	}

	.learning-task-panel__summary dt {
		color: #64748b;
		font-size: 0.9rem;
		font-weight: 700;
	}

	.learning-task-panel__summary dd {
		margin: 0;
		color: #334155;
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.learning-task-panel h3 {
		margin: 1.2rem 0 0.4rem;
		font-size: 0.95rem;
	}

	.learning-task-panel ul,
	.learning-task-panel ol {
		margin: 0;
		padding-left: 1.3rem;
		line-height: 1.7;
	}

	.learning-task-panel li {
		margin: 0.25rem 0;
	}

	.learning-task-panel > p {
		margin: 0.65rem 0 0;
		line-height: 1.65;
	}

	@media (max-width: 560px) {
		.learning-task-panel__summary {
			grid-template-columns: 1fr;
			gap: 0.1rem;
		}

		.learning-task-panel__summary dd + dt {
			margin-top: 0.4rem;
		}
	}
</style>
