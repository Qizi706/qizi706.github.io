---
type ImageSize = number | string;

interface Props {
	src: string;
	alt: string;
	width?: ImageSize;
	height?: ImageSize;
	maxWidth?: ImageSize;
	caption?: string;
	align?: 'left' | 'center' | 'right';
	fit?: 'contain' | 'cover' | 'fill' | 'none' | 'scale-down';
	class?: string;
	loading?: 'eager' | 'lazy';
}

const {
	src,
	alt,
	width = '100%',
	height = 'auto',
	maxWidth = '100%',
	caption,
	align = 'center',
	fit = 'contain',
	class: className,
	loading = 'lazy',
} = Astro.props;

const toCssSize = (value: ImageSize) =>
	typeof value === 'number' ? `${value}px` : value;

const figureStyle = [
	`--article-image-width: ${toCssSize(width)}`,
	`--article-image-height: ${toCssSize(height)}`,
	`--article-image-max-width: ${toCssSize(maxWidth)}`,
	`--article-image-fit: ${fit}`,
].join('; ');
---

<figure
	class:list={['article-image', `article-image--${align}`, className]}
	style={figureStyle}
>
	<img
		class="article-image__media"
		src={src}
		alt={alt}
		loading={loading}
		decoding="async"
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.article-image {
		width: var(--article-image-width);
		max-width: var(--article-image-max-width);
		margin-top: 0.75rem;
		margin-bottom: 0.75rem;
		padding: 0;
		text-indent: 0;
	}

	.article-image--left {
		margin-right: auto;
		margin-left: 0;
	}

	.article-image--center {
		margin-right: auto;
		margin-left: auto;
	}

	.article-image--right {
		margin-right: 0;
		margin-left: auto;
	}

	.article-image .article-image__media {
		display: block;
		width: 100%;
		max-width: none;
		height: var(--article-image-height);
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		object-fit: var(--article-image-fit);
	}

	.article-image figcaption {
		margin-top: 0.375rem;
	}
</style>
