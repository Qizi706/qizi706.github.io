---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { getCategoryUrl, getPostUrl } from '../utils/posts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryCounts = posts.reduce((counts, post) => {
	for (const category of post.data.categories) {
		counts.set(category, (counts.get(category) ?? 0) + 1);
	}
	return counts;
}, new Map<string, number>());

const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
const featuredPost = posts.find((post) => post.id === 'conjecture-verification-practice');
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<header class="intro">
		<h1>{SITE_TITLE}</h1>
	</header>

	<section class="personal-section" aria-labelledby="personal-heading">
		<div class="personal-intro">
			<p class="description-text">
				我是周权，就读于中国科学技术大学软件学院，研究生二年级。对底层技术痴迷，喜爱研究
				<b> Linux (Arch 用户)</b>，熟悉 <b>C/C++ 语言</b
				>，目前在国内某大厂实习，工作内容是分布式存储。
			</p>
			<div class="status-line">
				<span class="status-dot" aria-hidden="true"></span>
				<span>currently exploring: kernels · storage · AI infra</span>
			</div>
			<a class="github-link" href="https://github.com/Qizi706" target="_blank" rel="noreferrer">
				↗ github.com/Qizi706
			</a>
		</div>
		<h2 id="personal-heading">个人状态</h2>
		<ul class="personal-links">
			<li><a href="/about">(Pending) 近期进展</a></li>
		</ul>
	</section>

	{
		featuredPost && (
			<section class="featured-section" aria-labelledby="featured-heading">
				<h2 id="featured-heading">最近写作</h2>
				<p class="description-text">{featuredPost.data.description}</p>
				<ul class="featured-links">
					<li>
						<a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a>
						<small>
							（{featuredPost.data.categories.join(' / ')} ·{' '}
							<FormattedDate date={featuredPost.data.pubDate} /> 有感而写）
						</small>
					</li>
				</ul>
				<div class="featured-image">
					<img
						src="/assets/home/roll-safe.png"
						alt="Roll Safe"
						width="400"
						height="353"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</section>
		)
	}

	{
		categories.length > 0 && (
			<section aria-labelledby="topics-heading">
				<h2 id="topics-heading">文章存档</h2>
				<ul class="category-links">
					{categories.map(([category, count]) => (
						<li>
							<a href={getCategoryUrl(category)}>{category}</a>
							<small>（{count} 篇文章）</small>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	:global(.page-frame.home-page) {
		color: #0f172a;
	}

	:global(.page-frame.home-page) a,
	:global(.page-frame.home-page) a:hover {
		color: #3730a3;
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: inherit;
		font-style: normal;
		font-weight: 500;
		line-height: inherit;
		letter-spacing: normal;
		text-transform: none;
		text-decoration: none;
	}

	.intro {
		padding-bottom: 0;
	}

	.intro h1 {
		padding: 1.5rem 0 0;
		margin: 0;
		color: #111827;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 2rem;
	}

	.lead {
		max-width: 38rem;
		margin: 0;
		color: rgb(var(--gray));
	}

	section {
		margin-top: 2rem;
	}

	.personal-section {
		margin-top: 2rem;
	}

	.personal-links,
	.featured-links,
	.category-links {
		margin: 0.25rem 0;
		padding: 0 0 0 0.5rem;
		list-style-position: inside;
		list-style-type: disc;
	}

	.personal-links li,
	.featured-links li,
	.category-links li {
		margin: 0 1rem;
		padding: 0;
		text-align: justify;
		overflow-wrap: normal;
		word-break: normal;
	}

	.personal-links li::marker,
	.featured-links li::marker,
	.category-links li::marker {
		color: #d1d5db;
	}

	.personal-intro {
		margin-bottom: 2rem;
	}

	.description-text {
		margin: 0;
		padding: 0;
		color: rgb(15 23 42);
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.625;
		text-align: justify;
		text-indent: 2em;
		overflow-wrap: normal;
		word-break: normal;
	}

	.status-line,
	.github-link {
		font-family: var(--font-mono);
	}

	.status-line {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 1.1rem 0 0.8rem;
		color: #0f172a;
		font-size: 0.72rem;
	}

	.status-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #16a34a;
		box-shadow: 0 0 0 3px rgb(22 163 74 / 12%);
	}

	.github-link {
		display: inline-block;
		font-size: 0.78rem;
	}

	section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
	}

	.featured-links small {
		margin-left: 0.2rem;
		color: #0f172a;
		font-size: 0.8rem;
	}

	.featured-image {
		display: flex;
		justify-content: center;
		margin: 0;
	}

	.featured-image img {
		display: block;
		width: 300px;
		max-width: 100%;
		height: auto;
		margin: 0.5rem 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		object-fit: contain;
	}

	.category-links small {
		margin-left: 0.25rem;
		color: #0f172a;
		font-size: 0.8rem;
	}
</style>
