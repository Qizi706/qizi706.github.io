---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import LearningStage from '../components/LearningStage.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { getLabManifest } from '../utils/lab-artifacts.mjs';
import { getCategoryUrl, getDraftPostUrl, getPostUrl } from '../utils/posts';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const draftPosts = import.meta.env.DEV
	? allPosts
			.filter((post) => post.data.draft)
			.sort(
				(a, b) =>
					(b.data.updatedDate ?? b.data.pubDate).valueOf() -
					(a.data.updatedDate ?? a.data.pubDate).valueOf(),
			)
	: [];

interface CategorySummary {
	name: string;
	count: number;
	earliestPubDate: Date;
	latestPubDate: Date;
}

const categorySummaries = posts.reduce((summaries, post) => {
	for (const category of post.data.categories) {
		const current = summaries.get(category);

		if (!current) {
			summaries.set(category, {
				name: category,
				count: 1,
				earliestPubDate: post.data.pubDate,
				latestPubDate: post.data.pubDate,
			});
			continue;
		}

		current.count += 1;
		if (post.data.pubDate < current.earliestPubDate) current.earliestPubDate = post.data.pubDate;
		if (post.data.pubDate > current.latestPubDate) current.latestPubDate = post.data.pubDate;
	}
	return summaries;
}, new Map<string, CategorySummary>());

const categories = [...categorySummaries.values()].sort(
	(a, b) =>
		b.earliestPubDate.valueOf() - a.earliestPubDate.valueOf() ||
		b.latestPubDate.valueOf() - a.latestPubDate.valueOf() ||
		a.name.localeCompare(b.name, 'zh-CN'),
);
const featuredPost = posts.find((post) => post.id === 'conjecture-verification-practice');
const systemBuildingPost = posts.find((post) => post.id === 'build-a-complete-system-from-scratch');
const kvCacheLab = await getLabManifest('kv-cache-batch');
const learningProgress = kvCacheLab.progress;
const learningMilestone = learningProgress.milestone;
const featuredCompletedStages = learningProgress.completed.filter(
	(stage: { featured?: boolean }) => stage.featured,
);
const currentStage = learningProgress.current;
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<header class="intro">
		<h1>{SITE_TITLE}</h1>
	</header>

	<figure class="epigraph">
		<blockquote cite="https://arxiv.org/abs/2002.05202">
			<p class="quote-original" lang="en">
				“We offer no explanation as to why these architectures seem to work; we attribute their
				success, as all else, to divine benevolence.”
			</p>
			<p class="quote-translation" lang="zh-CN">
				“对于为什么架构似乎行之有效，我们不做任何说明；与世间万事一样，我们将它们的成功归功于神的眷顾。”
			</p>
			<footer>
				<span aria-hidden="true">——</span>
				<cite>
					<a href="https://arxiv.org/abs/2002.05202" target="_blank" rel="noreferrer">
						Noam Shazeer 《GLU Variants Improve Transformer》 arXiv:2002.05202 · 2020
					</a>
				</cite>
			</footer>
		</blockquote>
	</figure>

	<div class="personal-intro">
		<p class="description-text">
			我是周权，就读于中国科学技术大学软件学院，研究生二年级。对底层技术痴迷，喜爱研究
			<b> Linux (Arch 用户)</b>，熟悉 <b>C/C++ 语言</b
			>，目前在国内某大厂实习，工作内容是分布式存储。
		</p>
		<nav class="profile-links" aria-label="个人链接">
			<a href="https://github.com/Qizi706" target="_blank" rel="noreferrer">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3.3-.4 6.8-1.6 6.8-7A5.4 5.4 0 0 0 19.4 4 5 5 0 0 0 19.3.5S18.2.1 15 1.8a13.4 13.4 0 0 0-6 0C5.8.1 4.7.5 4.7.5A5 5 0 0 0 4.6 4a5.4 5.4 0 0 0-1.4 3.7c0 5.4 3.5 6.5 6.8 7A4.8 4.8 0 0 0 9 18v4"
					></path>
					<path d="M9 18c-4.5 2-5-2-7-2"></path>
				</svg>
				<span>github.com/Qizi706</span>
			</a>
			<a href="/about/">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="10"></circle>
					<path d="M12 11v5"></path>
					<path d="M12 8h.01"></path>
				</svg>
				<span>about</span>
			</a>
		</nav>
	</div>

	{
		import.meta.env.DEV && draftPosts.length > 0 && (
			<section class="draft-section" aria-labelledby="draft-heading">
				<div class="draft-heading">
					<h2 id="draft-heading">
						<a href="/draft/">本地草稿</a>
					</h2>
					<span class="draft-badge">DEV ONLY · {draftPosts.length}</span>
				</div>
				<p class="draft-description">
					这些页面只在本地开发服务器中生成。点击标题可直接检查文章内容和渲染效果。
				</p>
				<ul class="draft-links">
					{draftPosts.map((post) => {
						const lastModified = post.data.updatedDate ?? post.data.pubDate;

						return (
							<li>
								<a href={getDraftPostUrl(post)}>{post.data.title}</a>
								<small>
									{post.data.categories.join(' / ') || '未分类'} · 更新于{' '}
									<FormattedDate date={lastModified} />
								</small>
							</li>
						);
					})}
				</ul>
			</section>
		)
	}

	{
		featuredPost && (
			<section class="featured-section" aria-labelledby="featured-heading">
				<h2 id="featured-heading">最近写作</h2>
				<p class="description-text">{featuredPost.data.description}</p>
				<ul class="featured-links">
					<li>
						<a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a>
						<small>
							（{featuredPost.data.categories.join(' / ')} ·{' '}
							<FormattedDate date={featuredPost.data.pubDate} /> 有感而写）
						</small>
					</li>
					{systemBuildingPost && (
						<li>
							<a href={getPostUrl(systemBuildingPost)}>{systemBuildingPost.data.title}</a>
							<small>
								（{systemBuildingPost.data.categories.join(' / ')} ·{' '}
								<FormattedDate date={systemBuildingPost.data.pubDate} />）
							</small>
						</li>
					)}
				</ul>
				<div class="featured-image">
					<img
						src="/assets/home/roll-safe.png"
						alt="Roll Safe"
						width="400"
						height="353"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</section>
		)
	}

	<section class="tomorrow-section" aria-labelledby="tomorrow-heading">
		<h2 id="tomorrow-heading">明日学习</h2>
		<div class="tomorrow-milestone" aria-label="当前阶段目标">
			<p><strong>{learningMilestone.title}</strong> · {learningMilestone.goal}</p>
			<dl>
				<div>
					<dt>core route</dt>
					<dd>{learningMilestone.coreRoute}</dd>
				</div>
				<div>
					<dt>final output</dt>
					<dd>{learningMilestone.finalArtifact}</dd>
				</div>
			</dl>
		</div>
		{
			featuredCompletedStages.map(
				(stage: { id: string; period: string; title: string; summary: string }) => (
					<LearningStage period={stage.period} title={`${stage.id} · ${stage.title}`} status="done">
						<p class="tomorrow-objective">
							<strong>完成依据：</strong>
							{stage.summary}
						</p>
					</LearningStage>
				),
			)
		}

		<LearningStage
			period={currentStage.period}
			title={`${currentStage.id} · ${currentStage.title}`}
			status="active"
			open
		>
			<p class="tomorrow-objective">
				<strong>唯一目标：</strong>
				{currentStage.objective}
			</p>

			<dl class="tomorrow-contract" aria-label="明日学习契约">
				<div>
					<dt>question</dt>
					<dd>{currentStage.question}</dd>
				</div>
				<div>
					<dt>prediction</dt>
					<dd>{currentStage.prediction}</dd>
				</div>
				<div>
					<dt>pre-read · 15 min</dt>
					<dd>
						只读{
							currentStage.preRead.map(
								(reference: { label: string; href: string }, index: number) => (
									<>
										{index > 0 ? '、' : ''}
										<a href={reference.href}>{reference.label}</a>
									</>
								),
							)
						}；每处只记一句对预测的确认或修正。
					</dd>
				</div>
				<div>
					<dt>artifact</dt>
					<dd>
						{currentStage.artifact}{' '}
						<a href={`/labs/kv-cache-batch/${currentStage.document}`}>打开工作表</a>
					</dd>
				</div>
				<div>
					<dt>gate</dt>
					<dd>{currentStage.acceptance}</dd>
				</div>
			</dl>

			<ol class="tomorrow-steps">
				{currentStage.steps.map((step: string) => <li>{step}</li>)}
			</ol>

			<p class="tomorrow-decision">
				<strong>下一步判断：</strong>
				{currentStage.nextDecision}
			</p>
		</LearningStage>
	</section>

	{
		categories.length > 0 && (
			<section aria-labelledby="topics-heading">
				<h2 id="topics-heading">文章存档</h2>
				<ul class="category-links">
					{categories.map(({ name, count }) => (
						<li>
							<a href={getCategoryUrl(name)}>{name}</a>
							<small>（{count} 篇文章）</small>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	:global(.page-frame.home-page) {
		color: #0f172a;
	}

	:global(.page-frame.home-page) a,
	:global(.page-frame.home-page) a:hover {
		color: #3730a3;
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: inherit;
		font-style: normal;
		font-weight: 500;
		line-height: inherit;
		letter-spacing: normal;
		text-transform: none;
		text-decoration: none;
	}

	.intro {
		padding-bottom: 0;
	}

	.intro h1 {
		padding: 1.5rem 0 0;
		margin: 0;
		color: #111827;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 2rem;
	}

	.lead {
		max-width: 38rem;
		margin: 0;
		color: rgb(var(--gray));
	}

	section {
		margin-top: 2rem;
	}

	.epigraph {
		width: auto;
		margin: 2rem 0 2.25rem max(0rem, calc((100% - 34rem) / 2));
	}

	.epigraph blockquote {
		margin: 0;
		padding: 0.15rem 0 0.1rem 1.4rem;
		border-left: 3px solid rgb(var(--gray-light));
	}

	.quote-original {
		margin: 0;
		color: #334155;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-style: italic;
		font-weight: 600;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.quote-translation {
		margin: 0.7rem 0 0;
		color: #334155;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-style: italic;
		font-weight: 500;
		line-height: 1.7;
	}

	.epigraph footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.2rem 0.4rem;
		margin-top: 0.85rem;
		color: #334155;
		font-size: 0.68rem;
		line-height: 1.7;
		text-align: right;
	}

	:global(.page-frame.home-page) .epigraph footer a {
		color: #475569;
		font-family: var(--font-body);
		font-weight: 500;
	}

	@media (max-width: 520px) {
		.epigraph blockquote {
			padding-left: 1.2rem;
		}
	}

	.featured-links,
	.category-links,
	.draft-links {
		margin: 0.25rem 0;
		padding: 0 0 0 0.5rem;
		list-style-position: inside;
		list-style-type: disc;
	}

	.featured-links li,
	.category-links li,
	.draft-links li {
		margin: 0 1rem;
		padding: 0;
		text-align: justify;
		overflow-wrap: normal;
		word-break: normal;
	}

	.featured-links li::marker,
	.category-links li::marker,
	.draft-links li::marker {
		color: #d1d5db;
	}

	.draft-section {
		margin-top: 1rem;
		padding: 1rem 1.1rem;
		border: 1px dashed #cbd5e1;
		border-radius: var(--card-radius);
		background: rgb(248 250 252 / 72%);
	}

	.tomorrow-objective {
		margin: 0.8rem 0;
		color: #334155;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.tomorrow-milestone {
		margin: 0 0 1rem;
		padding: 0.85rem 1rem;
		border: 1px solid #e2e8f0;
		border-radius: var(--card-radius);
		background: rgb(248 250 252 / 60%);
	}

	.tomorrow-milestone p {
		margin: 0 0 0.7rem;
		color: #334155;
		font-size: 0.86rem;
		line-height: 1.6;
	}

	.tomorrow-milestone dl {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
	}

	.tomorrow-milestone dt {
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.tomorrow-milestone dd {
		margin: 0.25rem 0 0;
		color: #334155;
		font-size: 0.8rem;
		line-height: 1.5;
	}

	.tomorrow-contract {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
		margin: 0.8rem 0;
	}

	.tomorrow-contract div {
		padding: 0.55rem 0.65rem;
		border: 1px solid #e2e8f0;
		border-radius: var(--card-radius);
		background: rgb(248 250 252 / 60%);
	}

	.tomorrow-contract dt {
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.tomorrow-contract dd {
		margin: 0.25rem 0 0;
		color: #334155;
		font-size: 0.8rem;
		line-height: 1.5;
	}

	.tomorrow-steps {
		margin: 0.8rem 0;
		padding-left: 1.35rem;
		color: #334155;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.tomorrow-steps li {
		margin: 0.3rem 0;
	}

	.tomorrow-decision {
		margin: 0.75rem 0 0;
		padding-top: 0.65rem;
		border-top: 1px dashed #cbd5e1;
		color: #475569;
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.draft-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.draft-heading h2 {
		margin-bottom: 0.35rem;
	}

	.draft-badge {
		flex: none;
		padding: 0.1rem 0.4rem;
		border: 1px solid #cbd5e1;
		border-radius: var(--card-radius);
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		line-height: 1.4;
		letter-spacing: 0.04em;
	}

	.draft-description {
		margin: 0 0 0.65rem;
		color: #64748b;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.draft-links {
		margin-bottom: 0;
	}

	.draft-links li {
		margin-top: 0.3rem;
		margin-bottom: 0.3rem;
	}

	.draft-links small {
		display: block;
		margin: 0.05rem 0 0 1.1rem;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.personal-intro {
		margin-bottom: 0;
	}

	.description-text {
		margin: 0;
		padding: 0;
		color: rgb(15 23 42);
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.625;
		text-align: justify;
		text-indent: 2em;
		overflow-wrap: normal;
		word-break: normal;
	}

	.profile-links {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 1rem;
		margin-top: 1rem;
	}

	:global(.page-frame.home-page) .profile-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.profile-links svg {
		width: 0.9rem;
		height: 0.9rem;
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
	}

	.featured-links small {
		margin-left: 0.2rem;
		color: #0f172a;
		font-size: 0.8rem;
	}

	.featured-image {
		display: flex;
		justify-content: center;
		margin: 0;
	}

	.featured-image img {
		display: block;
		width: 300px;
		max-width: 100%;
		height: auto;
		margin: 0.5rem 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		object-fit: contain;
	}

	.category-links small {
		margin-left: 0.25rem;
		color: #0f172a;
		font-size: 0.8rem;
	}

	@media (max-width: 520px) {
		.tomorrow-milestone dl,
		.tomorrow-contract {
			grid-template-columns: 1fr;
		}

		.draft-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0;
		}
	}
</style>
