---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import LearningStage from '../components/LearningStage.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { getCategoryUrl, getPostUrl } from '../utils/posts';

const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const draftPosts = import.meta.env.DEV
	? allPosts
			.filter((post) => post.data.draft)
			.sort(
				(a, b) =>
					(b.data.updatedDate ?? b.data.pubDate).valueOf() -
					(a.data.updatedDate ?? a.data.pubDate).valueOf(),
			)
	: [];

interface CategorySummary {
	name: string;
	count: number;
	earliestPubDate: Date;
	latestPubDate: Date;
}

const categorySummaries = posts.reduce((summaries, post) => {
	for (const category of post.data.categories) {
		const current = summaries.get(category);

		if (!current) {
			summaries.set(category, {
				name: category,
				count: 1,
				earliestPubDate: post.data.pubDate,
				latestPubDate: post.data.pubDate,
			});
			continue;
		}

		current.count += 1;
		if (post.data.pubDate < current.earliestPubDate) current.earliestPubDate = post.data.pubDate;
		if (post.data.pubDate > current.latestPubDate) current.latestPubDate = post.data.pubDate;
	}
	return summaries;
}, new Map<string, CategorySummary>());

const categories = [...categorySummaries.values()].sort(
	(a, b) =>
		b.earliestPubDate.valueOf() - a.earliestPubDate.valueOf() ||
		b.latestPubDate.valueOf() - a.latestPubDate.valueOf() ||
		a.name.localeCompare(b.name, 'zh-CN'),
);
const featuredPost = posts.find((post) => post.id === 'conjecture-verification-practice');
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<header class="intro">
		<h1>{SITE_TITLE}</h1>
	</header>

	<figure class="epigraph">
		<blockquote cite="https://arxiv.org/abs/2002.05202">
			<p class="quote-original" lang="en">
				“We offer no explanation as to why these architectures seem to work; we attribute their
				success, as all else, to divine benevolence.”
			</p>
			<p class="quote-translation" lang="zh-CN">
				“对于为什么架构似乎行之有效，我们不做任何说明；与世间万事一样，我们将它们的成功归功于神的眷顾。”
			</p>
			<footer>
				<span aria-hidden="true">——</span>
				<cite>
					<a href="https://arxiv.org/abs/2002.05202" target="_blank" rel="noreferrer">
						Noam Shazeer 《GLU Variants Improve Transformer》 arXiv:2002.05202 · 2020
					</a>
				</cite>
			</footer>
		</blockquote>
	</figure>

	<section class="personal-section" aria-labelledby="personal-heading">
		<div class="personal-intro">
			<p class="description-text">
				我是周权，就读于中国科学技术大学软件学院，研究生二年级。对底层技术痴迷，喜爱研究
				<b> Linux (Arch 用户)</b>，熟悉 <b>C/C++ 语言</b
				>，目前在国内某大厂实习，工作内容是分布式存储。
			</p>
			<div class="status-line">
				<span class="status-dot" aria-hidden="true"></span>
				<span>currently exploring: kernels · storage · AI infra</span>
			</div>
			<a class="github-link" href="https://github.com/Qizi706" target="_blank" rel="noreferrer">
				↗ github.com/Qizi706
			</a>
		</div>
		<h2 id="personal-heading">个人状态</h2>
		<ul class="personal-links">
			<li><a href="/about/">(Pending) 近期进展</a></li>
		</ul>
	</section>

	<section class="tomorrow-section" aria-labelledby="tomorrow-heading">
		<h2 id="tomorrow-heading">明日学习</h2>
		<LearningStage period="2026.08.18" title="M1 · Batch Size 曲线与吞吐拐点" status="done">
			<p class="tomorrow-objective">
				<strong>完成依据：</strong><code>{'B∈{1,2,4,8}'}</code> 全部通过独立 Oracle 与 Shape 检查；240
				条原始样本可重建 P50/P95、Positions/s、两张曲线和 <code>Knee: B=8</code>。
			</p>
		</LearningStage>

		<LearningStage
			period="2026.08.19 · 120 min"
			title="P0 · NumPy View/Copy 与轴语义闭环"
			status="active"
			open
		>
			<p class="tomorrow-objective">
				<strong>目标：</strong>在进入 MHA/GQA 前，不看运行结果也能预测 Binding、基础切片、Advanced
				Indexing、<code>swapaxes</code> 和 <code>concatenate</code> 的 Shape、内存共享与分配行为，并把它们映射回当前
				Attention/KV Cache 实现。
			</p>

			<dl class="tomorrow-contract" aria-label="明日学习契约">
				<div>
					<dt>question</dt>
					<dd>
						哪些 NumPy 操作只创建 View，哪些会复制或分配新 Buffer，轴变换又怎样影响 Attention
						Shape？
					</dd>
				</div>
				<div>
					<dt>prediction</dt>
					<dd>
						基础切片和 <code>swapaxes</code> 通常共享内存；Advanced Indexing 与 <code
							>concatenate</code
						> 产生新 Buffer。
					</dd>
				</div>
				<div>
					<dt>artifact</dt>
					<dd>
						<code>docs/NUMPY_SEMANTICS_NOTES.md</code>：事前预测、实际输出、差异解释和 Lab 映射。
					</dd>
				</div>
				<div>
					<dt>gate</dt>
					<dd>
						不看代码也能解释 View/Copy/Stride/Allocation，并指出哪些操作会污染输入或增加 Benchmark
						成本。
					</dd>
				</div>
			</dl>

			<ol class="tomorrow-steps">
				<li>
					<b>20 min</b>：逐段阅读 <code>examples/numpy_array_semantics.py</code>，先写
					Shape、共享关系和修改传播预测。
				</li>
				<li><b>25 min</b>：运行示例，保存完整输出，逐项标记 Supported 或 Refuted。</li>
				<li>
					<b>35 min</b>：分别修改 Slice、Advanced Indexing 和 Swapped View，使用 <code
						>np.shares_memory</code
					> 与 Stride 验证原因。
				</li>
				<li>
					<b>25 min</b>：回到 <code>attention.py</code>，解释 <code>x[:, t:t+1, :]</code>、<code
						>swapaxes</code
					> 与动态 Cache 拼接的成本。
				</li>
				<li><b>15 min</b>：关闭代码完成口述验收，记录至少一个预测错误及修正后的规则。</li>
			</ol>

			<p class="tomorrow-decision">
				<strong>下一步判断：</strong>若能脱离代码解释五类操作及其在 Lab 中的作用，P0 标记完成并进入
				M2-A Shape 契约；否则只补做答错的操作，不扩展新的 Python 教程。
			</p>
		</LearningStage>
	</section>

	{
		import.meta.env.DEV && draftPosts.length > 0 && (
			<section class="draft-section" aria-labelledby="draft-heading">
				<div class="draft-heading">
					<h2 id="draft-heading">本地草稿</h2>
					<span class="draft-badge">DEV ONLY · {draftPosts.length}</span>
				</div>
				<p class="draft-description">
					这些页面只在本地开发服务器中生成。点击标题可直接检查文章内容和渲染效果。
				</p>
				<ul class="draft-links">
					{draftPosts.map((post) => {
						const lastModified = post.data.updatedDate ?? post.data.pubDate;

						return (
							<li>
								<a href={getPostUrl(post)}>{post.data.title}</a>
								<small>
									{post.data.categories.join(' / ') || '未分类'} · 更新于{' '}
									<FormattedDate date={lastModified} />
								</small>
							</li>
						);
					})}
				</ul>
			</section>
		)
	}

	{
		featuredPost && (
			<section class="featured-section" aria-labelledby="featured-heading">
				<h2 id="featured-heading">最近写作</h2>
				<p class="description-text">{featuredPost.data.description}</p>
				<ul class="featured-links">
					<li>
						<a href={getPostUrl(featuredPost)}>{featuredPost.data.title}</a>
						<small>
							（{featuredPost.data.categories.join(' / ')} ·{' '}
							<FormattedDate date={featuredPost.data.pubDate} /> 有感而写）
						</small>
					</li>
				</ul>
				<div class="featured-image">
					<img
						src="/assets/home/roll-safe.png"
						alt="Roll Safe"
						width="400"
						height="353"
						loading="lazy"
						decoding="async"
					/>
				</div>
			</section>
		)
	}

	{
		categories.length > 0 && (
			<section aria-labelledby="topics-heading">
				<h2 id="topics-heading">文章存档</h2>
				<ul class="category-links">
					{categories.map(({ name, count }) => (
						<li>
							<a href={getCategoryUrl(name)}>{name}</a>
							<small>（{count} 篇文章）</small>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	:global(.page-frame.home-page) {
		color: #0f172a;
	}

	:global(.page-frame.home-page) a,
	:global(.page-frame.home-page) a:hover {
		color: #3730a3;
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: inherit;
		font-style: normal;
		font-weight: 500;
		line-height: inherit;
		letter-spacing: normal;
		text-transform: none;
		text-decoration: none;
	}

	.intro {
		padding-bottom: 0;
	}

	.intro h1 {
		padding: 1.5rem 0 0;
		margin: 0;
		color: #111827;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 2rem;
	}

	.lead {
		max-width: 38rem;
		margin: 0;
		color: rgb(var(--gray));
	}

	section {
		margin-top: 2rem;
	}

	.epigraph {
		width: auto;
		margin: 2rem 0 2.25rem max(0rem, calc((100% - 34rem) / 2));
	}

	.epigraph blockquote {
		margin: 0;
		padding: 0.15rem 0 0.1rem 1.4rem;
		border-left: 3px solid rgb(var(--gray-light));
	}

	.quote-original {
		margin: 0;
		color: #334155;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-style: italic;
		font-weight: 600;
		line-height: 1.7;
		text-wrap: pretty;
	}

	.quote-translation {
		margin: 0.7rem 0 0;
		color: #334155;
		font-family: var(--font-body);
		font-size: 0.98rem;
		font-style: italic;
		font-weight: 500;
		line-height: 1.7;
	}

	.epigraph footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.2rem 0.4rem;
		margin-top: 0.85rem;
		color: #334155;
		font-size: 0.68rem;
		line-height: 1.7;
		text-align: right;
	}

	:global(.page-frame.home-page) .epigraph footer a {
		color: #475569;
		font-family: var(--font-body);
		font-weight: 500;
	}

	.personal-section {
		margin-top: 2rem;
	}

	@media (max-width: 520px) {
		.epigraph blockquote {
			padding-left: 1.2rem;
		}
	}

	.personal-links,
	.featured-links,
	.category-links,
	.draft-links {
		margin: 0.25rem 0;
		padding: 0 0 0 0.5rem;
		list-style-position: inside;
		list-style-type: disc;
	}

	.personal-links li,
	.featured-links li,
	.category-links li,
	.draft-links li {
		margin: 0 1rem;
		padding: 0;
		text-align: justify;
		overflow-wrap: normal;
		word-break: normal;
	}

	.personal-links li::marker,
	.featured-links li::marker,
	.category-links li::marker,
	.draft-links li::marker {
		color: #d1d5db;
	}

	.draft-section {
		padding: 1rem 1.1rem;
		border: 1px dashed #cbd5e1;
		border-radius: 2px;
		background: rgb(248 250 252 / 72%);
	}

	.tomorrow-objective {
		margin: 0.8rem 0;
		color: #334155;
		font-size: 0.9rem;
		line-height: 1.6;
	}

	.tomorrow-contract {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
		margin: 0.8rem 0;
	}

	.tomorrow-contract div {
		padding: 0.55rem 0.65rem;
		border: 1px solid #e2e8f0;
		background: rgb(248 250 252 / 60%);
	}

	.tomorrow-contract dt {
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.66rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.tomorrow-contract dd {
		margin: 0.25rem 0 0;
		color: #334155;
		font-size: 0.8rem;
		line-height: 1.5;
	}

	.tomorrow-steps {
		margin: 0.8rem 0;
		padding-left: 1.35rem;
		color: #334155;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.tomorrow-steps li {
		margin: 0.3rem 0;
	}

	.tomorrow-decision {
		margin: 0.75rem 0 0;
		padding-top: 0.65rem;
		border-top: 1px dashed #cbd5e1;
		color: #475569;
		font-size: 0.8rem;
		line-height: 1.55;
	}

	.draft-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.draft-heading h2 {
		margin-bottom: 0.35rem;
	}

	.draft-badge {
		flex: none;
		padding: 0.1rem 0.4rem;
		border: 1px solid #cbd5e1;
		border-radius: 2px;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		line-height: 1.4;
		letter-spacing: 0.04em;
	}

	.draft-description {
		margin: 0 0 0.65rem;
		color: #64748b;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.draft-links {
		margin-bottom: 0;
	}

	.draft-links li {
		margin-top: 0.3rem;
		margin-bottom: 0.3rem;
	}

	.draft-links small {
		display: block;
		margin: 0.05rem 0 0 1.1rem;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		line-height: 1.5;
	}

	.personal-intro {
		margin-bottom: 2rem;
	}

	.description-text {
		margin: 0;
		padding: 0;
		color: rgb(15 23 42);
		font-family: 'Kalam', 'Sans Serif', sans-serif;
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.625;
		text-align: justify;
		text-indent: 2em;
		overflow-wrap: normal;
		word-break: normal;
	}

	.status-line,
	.github-link {
		font-family: var(--font-mono);
	}

	.status-line {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 1.1rem 0 0.8rem;
		color: #0f172a;
		font-size: 0.72rem;
	}

	.status-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #16a34a;
		box-shadow: 0 0 0 3px rgb(22 163 74 / 12%);
	}

	.github-link {
		display: inline-block;
		font-size: 0.78rem;
	}

	section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
	}

	.featured-links small {
		margin-left: 0.2rem;
		color: #0f172a;
		font-size: 0.8rem;
	}

	.featured-image {
		display: flex;
		justify-content: center;
		margin: 0;
	}

	.featured-image img {
		display: block;
		width: 300px;
		max-width: 100%;
		height: auto;
		margin: 0.5rem 0;
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
		object-fit: contain;
	}

	.category-links small {
		margin-left: 0.25rem;
		color: #0f172a;
		font-size: 0.8rem;
	}

	@media (max-width: 520px) {
		.tomorrow-contract {
			grid-template-columns: 1fr;
		}

		.draft-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0;
		}
	}
</style>
