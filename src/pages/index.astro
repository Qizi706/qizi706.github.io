---
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import PageLayout from '../layouts/PageLayout.astro';
import { getCategoryUrl } from '../utils/posts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryCounts = posts.reduce((counts, post) => {
	for (const category of post.data.categories) {
		counts.set(category, (counts.get(category) ?? 0) + 1);
	}
	return counts;
}, new Map<string, number>());

const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION} mainClass="home-page">
	<header class="intro">
		<h1>{SITE_TITLE}</h1>
	</header>

	<section class="personal-section" aria-labelledby="personal-heading">
		<div class="personal-intro">
			<p>
				我是周权，就读于中国科学技术大学软件学院，研究生二年级。对底层技术痴迷，喜爱研究
				<b> Linux (Arch 用户)</b>，熟悉 <b>C/C++ 语言</b
				>，目前在国内某大厂实习，工作内容是分布式存储。
			</p>
			<div class="status-line">
				<span class="status-dot" aria-hidden="true"></span>
				<span>currently exploring: kernels · storage · AI infra</span>
			</div>
			<a class="github-link" href="https://github.com/Qizi706" target="_blank" rel="noreferrer">
				↗ github.com/Qizi706
			</a>
		</div>
		<h2 id="personal-heading">个人发布</h2>
		<ul class="personal-links">
			<li><a href="/about">(Pending) 近期进展</a></li>
		</ul>
	</section>

	{
		categories.length > 0 && (
			<section aria-labelledby="topics-heading">
				<h2 id="topics-heading">文章分类</h2>
				<ul class="category-links">
					{categories.map(([category, count]) => (
						<li>
							<a href={getCategoryUrl(category)}>{category}</a>
							<small>（{count} 篇文章）</small>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.intro {
		padding-bottom: 0;
	}

	.intro h1 {
		padding: 1.5rem 0 0;
		margin: 0;
		font-family: var(--font-heading);
		font-size: 1.5rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 2rem;
	}

	.lead {
		max-width: 38rem;
		margin: 0;
		color: rgb(var(--gray));
	}

	section {
		margin-top: 2rem;
	}

	.personal-section {
		margin-top: 2rem;
	}

	.personal-links {
		margin: 0.75rem 0 0;
		padding-left: 1.5rem;
	}

	.personal-links li {
		margin: 0.2rem 0;
	}

	.personal-intro {
		margin-bottom: 2rem;
	}

	.personal-intro p {
		max-width: 62ch;
	}

	.status-line,
	.github-link {
		font-family: var(--font-mono);
	}

	.status-line {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 1.1rem 0 0.8rem;
		color: rgb(var(--gray));
		font-size: 0.72rem;
	}

	.status-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #16a34a;
		box-shadow: 0 0 0 3px rgb(22 163 74 / 12%);
	}

	.github-link {
		display: inline-block;
		font-size: 0.78rem;
	}

	section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
	}

	.category-links {
		margin: 0.25rem 0 0;
		padding-left: 1.5rem;
	}

	.category-links li {
		margin: 0.3rem 0;
	}

	.category-links small {
		margin-left: 0.25rem;
		color: rgb(var(--gray));
		font-size: 0.8rem;
	}
</style>
