---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BlogArticle from '../../components/BlogArticle.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getDraftPostUrl } from '../../utils/posts';
import '../../styles/wiki-index.css';

interface DraftIndexProps {
	kind: 'index';
	posts: CollectionEntry<'blog'>[];
}

interface DraftPostProps {
	kind: 'post';
	post: CollectionEntry<'blog'>;
}

type Props = DraftIndexProps | DraftPostProps;

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => post.data.draft)
		.sort(
			(a, b) =>
				(b.data.updatedDate ?? b.data.pubDate).valueOf() -
				(a.data.updatedDate ?? a.data.pubDate).valueOf(),
		);

	return [
		{
			params: { slug: undefined },
			props: { kind: 'index' as const, posts },
		},
		...posts.map((post) => ({
			params: { slug: post.id },
			props: { kind: 'post' as const, post },
		})),
	];
}

const page: Props = Astro.props;
const description = `不进入正式文章归档的草稿预览，共 ${page.kind === 'index' ? page.posts.length : 1} 篇。`;
const archiveDateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Shanghai',
});
const formatArchiveDate = (date: Date) => archiveDateFormatter.format(date).replaceAll('/', '.');
---

{
	page.kind === 'post' ? (
		<BlogArticle post={page.post} />
	) : (
		<PageLayout title="草稿预览" {description} mainClass="wiki-index-page" noindex>
			<header class="wiki-page-header">
				<h1>草稿预览</h1>
				<ul class="wiki-index-list">
					<li>
						<strong>状态：</strong>UNLISTED · {page.posts.length}
					</li>
					<li>直达链接可以预览，但草稿不会进入正式文章归档、RSS 或 sitemap；这不是权限控制。</li>
					<li>
						<a href="/blog/">正式文章</a> | <a href="/">首页</a>
					</li>
				</ul>
			</header>

			<section class="wiki-index-section" aria-label="草稿目录">
				<h2>草稿目录</h2>
				{page.posts.length > 0 ? (
					<ol class="wiki-route-list">
						{page.posts.map((post) => {
							const lastModified = post.data.updatedDate ?? post.data.pubDate;
							return (
								<li>
									<time class="route-family is-gray" datetime={lastModified.toISOString()}>
										{formatArchiveDate(lastModified)}
									</time>
									<a href={getDraftPostUrl(post)}>{post.data.title}</a>
									{post.data.categories.length > 0 && `（${post.data.categories.join(' / ')}）`}
								</li>
							);
						})}
					</ol>
				) : (
					<p class="wiki-section-note">
						当前没有标记为 <code>draft: true</code> 的文章。
					</p>
				)}
			</section>
		</PageLayout>
	)
}
