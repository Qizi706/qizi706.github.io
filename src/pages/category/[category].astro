---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCategorySlug, getPostUrl } from '../../utils/posts';

interface Props {
	category: string;
	posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
	const categoryPosts = new Map<string, CollectionEntry<'blog'>[]>();

	for (const post of posts) {
		for (const category of post.data.categories) {
			const postsInCategory = categoryPosts.get(category) ?? [];
			postsInCategory.push(post);
			categoryPosts.set(category, postsInCategory);
		}
	}

	return [...categoryPosts.entries()].map(([category, posts]) => ({
		params: { category: getCategorySlug(category) },
		props: { category, posts },
	}));
}

const { category, posts } = Astro.props;
const description = `共 ${posts.length} 篇归档于 ${category} 分类的文章`;
const isAiInfra = getCategorySlug(category) === 'ai-infra';
const archiveDateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Shanghai',
});
const formatArchiveDate = (date: Date) => archiveDateFormatter.format(date).replaceAll('/', '.');
const firstPublishedAt = posts.at(0)?.data.pubDate;
const lastPublishedAt = posts.at(-1)?.data.pubDate;
const archiveRange =
	firstPublishedAt && lastPublishedAt
		? firstPublishedAt.valueOf() === lastPublishedAt.valueOf()
			? formatArchiveDate(firstPublishedAt)
			: `${formatArchiveDate(firstPublishedAt)} 至 ${formatArchiveDate(lastPublishedAt)}`
		: '';
---

<PageLayout title={`${category} | ${SITE_TITLE}`} {description} mainClass="category-page">
	<header class="page-heading">
		<h1>{category}</h1>
		{
			isAiInfra ? (
				<ul class="category-summary">
					<li>学习主题：LLM 推理与 Serving</li>
					<li>当前阶段：请求链路、Prefill、Decode、KV Cache 与本地推理服务</li>
					<li>文章：共 {posts.length} 篇；理论知识与验证实验并列阅读</li>
				</ul>
			) : (
				<ul class="category-summary">
					<li>{description}</li>
					{archiveRange && <li>收录时间：{archiveRange}</li>}
					<li>文章按发布时间由旧到新排列，编号即建议阅读顺序</li>
				</ul>
			)
		}
	</header>

	<section aria-label={`${category} 分类下的文章`}>
		<h2>{isAiInfra ? '学习内容' : '文章目录'}</h2>
		{
			isAiInfra ? (
				<ol class="post-list ai-infra-list">
					<li>
						<span class="archive-label archive-label-gray">推理基础</span>{' '}
						{posts.map((post, index) => (
							<>
								{index > 0 && <span class="post-separator"> | </span>}
								<a class="post-title" href={getPostUrl(post)}>
									{post.data.title}
								</a>
							</>
						))}
					</li>
				</ol>
			) : (
				<ol class="post-list">
					{posts.map((post) => (
						<li>
							<time
								class="archive-label archive-label-gray"
								datetime={post.data.pubDate.toISOString()}
							>
								{formatArchiveDate(post.data.pubDate)}
							</time>{' '}
							<a class="post-title" href={getPostUrl(post)}>
								{post.data.title}
							</a>
						</li>
					))}
				</ol>
			)
		}
	</section>
</PageLayout>

<style>
	:global(.page-frame.category-page) {
		font-family: var(--font-body);
		line-height: 1.75;
	}

	.page-heading {
		margin: 0;
	}

	.page-heading h1 {
		padding: 1.5rem 0 0;
		margin: 0 0 1rem;
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.category-summary {
		margin: 0.25rem 0;
		padding: 0 0 0 0.5rem;
		list-style-position: inside;
		list-style-type: disc;
		text-align: left;
	}

	.category-summary li {
		margin: 0 1rem;
		padding: 0;
		text-align: justify;
		overflow-wrap: normal;
		word-break: normal;
	}

	section {
		margin: 0;
	}

	section h2 {
		margin: 0;
		padding: 1.5rem 0 0.5rem;
		font-size: 1.25rem;
		line-height: 1.75rem;
	}

	.post-list {
		margin: 0.75rem 1rem;
		padding: 0 0 0 0.5rem;
		list-style-position: inside;
		list-style-type: decimal;
		text-align: justify;
	}

	.post-list li {
		margin: 0;
		padding: 0;
		text-align: justify;
		overflow-wrap: normal;
		word-break: normal;
	}

	.archive-label {
		display: inline;
		padding: 0 0.25rem;
		border-color: #94a3b8;
		color: inherit;
		font: inherit;
		white-space: nowrap;
	}

	.archive-label-gray {
		background: #f1f5f9;
	}

	.post-title {
		font-weight: 500;
		line-height: inherit;
	}

	.post-separator {
		white-space: pre;
	}

	@media (min-width: 768px) {
		:global(.page-frame.category-page) {
			border-width: 1px;
			border-radius: 0;
			box-shadow: var(--wiki-frame-shadow);
		}
	}
</style>
