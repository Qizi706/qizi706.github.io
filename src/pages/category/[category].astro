---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCategorySlug, getPostUrl } from '../../utils/posts';

interface Props {
	category: string;
	posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
	const categoryPosts = new Map<string, CollectionEntry<'blog'>[]>();

	for (const post of posts) {
		for (const category of post.data.categories) {
			const postsInCategory = categoryPosts.get(category) ?? [];
			postsInCategory.push(post);
			categoryPosts.set(category, postsInCategory);
		}
	}

	return [...categoryPosts.entries()].map(([category, posts]) => ({
		params: { category: getCategorySlug(category) },
		props: { category, posts },
	}));
}

const { category, posts } = Astro.props;
const description = `共 ${posts.length} 篇归档于 ${category} 分类的文章`;
---

<PageLayout title={`${category} | ${SITE_TITLE}`} {description} mainClass="category-page">
	<header class="page-heading">
		<h1>{category}</h1>
		<ul class="category-summary">
			<li>{description}，按发布时间由旧到新排列</li>
		</ul>
	</header>

	<section aria-label={`${category} 分类下的文章`}>
		<h2>文章目录</h2>
		<ol class="post-list">
			{
				posts.map((post) => (
					<li>
						<a class="post-title" href={getPostUrl(post)}>
							{post.data.title}
						</a>
						<small class="post-meta">
							（<FormattedDate date={post.data.pubDate} />
							{post.data.tags.slice(0, 3).map((tag) => (
								<span> · #{tag}</span>
							))}
							）
						</small>
					</li>
				))
			}
		</ol>
	</section>
</PageLayout>

<style>
	.page-heading {
		margin-bottom: 2rem;
	}

	.page-heading h1 {
		padding: 1.5rem 0 0;
		margin: 0 0 1rem;
		font-size: 1.5rem;
		line-height: 2rem;
	}

	.category-summary {
		margin: 0;
		padding-left: 1.5rem;
	}

	.category-summary li {
		margin: 0.25rem 0;
	}

	section {
		margin-top: 2rem;
	}

	section h2 {
		margin: 0 0 0.75rem;
		font-size: 1.2rem;
	}

	.post-list {
		margin: 0.25rem 0 0;
		padding-left: 1.75rem;
	}

	.post-list li {
		margin: 0.45rem 0;
		padding-left: 0.1rem;
	}

	.post-meta {
		margin-left: 0.25rem;
		color: rgb(var(--gray));
		font-size: 0.75rem;
		font-weight: 400;
		line-height: 1.5;
	}
</style>
