---
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getPostUrl } from '../../utils/posts';
import '../../styles/wiki-index.css';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const archiveDateFormatter = new Intl.DateTimeFormat('zh-CN', {
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
	timeZone: 'Asia/Shanghai',
});
const formatArchiveDate = (date: Date) => archiveDateFormatter.format(date).replaceAll('/', '.');
---

<PageLayout
	title={`文章 | ${SITE_TITLE}`}
	description={SITE_DESCRIPTION}
	mainClass="wiki-index-page"
>
	<header class="wiki-page-header">
		<h1>文章</h1>
		<ul class="wiki-index-list">
			<li>共 {posts.length} 篇正式文章；按发布时间由新到旧排列。</li>
			<li>分类页用于按主题阅读，本页只保留完整时间索引。</li>
			<li><a href="/">首页</a> | <a href="/learning/">实验路线</a></li>
		</ul>
	</header>

	<section class="wiki-index-section" aria-label="文章目录">
		<h2>文章目录</h2>
		<ol class="wiki-route-list">
			{
				posts.map((post) => (
					<li>
						<time class="route-family is-gray" datetime={post.data.pubDate.toISOString()}>
							{formatArchiveDate(post.data.pubDate)}
						</time>
						<a href={getPostUrl(post)}>{post.data.title}</a>
					</li>
				))
			}
		</ol>
	</section>
</PageLayout>
