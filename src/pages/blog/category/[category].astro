---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import FormattedDate from '../../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../../consts';
import PageLayout from '../../../layouts/PageLayout.astro';
import { getCategorySlug, getPostUrl } from '../../../utils/posts';

interface Props {
	category: string;
	posts: CollectionEntry<'blog'>[];
}

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((post) => !post.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	const categoryPosts = new Map<string, CollectionEntry<'blog'>[]>();

	for (const post of posts) {
		for (const category of post.data.categories) {
			const postsInCategory = categoryPosts.get(category) ?? [];
			postsInCategory.push(post);
			categoryPosts.set(category, postsInCategory);
		}
	}

	return [...categoryPosts.entries()].map(([category, posts]) => ({
		params: { category: getCategorySlug(category) },
		props: { category, posts },
	}));
}

const { category, posts } = Astro.props;
const description = `共 ${posts.length} 篇归档于 ${category} 分类的文章`;
---

<PageLayout title={`${category} | ${SITE_TITLE}`} {description} mainClass="category-page">
	<header class="page-heading">
		<p class="path"><a href="/blog">~/blog</a>/category</p>
		<h1>{category}</h1>
		<p>{description}</p>
	</header>

	<section aria-label={`${category} 分类下的文章`}>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<article>
							<div class="post-heading">
								<a class="post-title" href={getPostUrl(post)}>
									<h2>{post.data.title}</h2>
								</a>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</div>
							<p class="post-description">{post.data.description}</p>
						</article>
					</li>
				))
			}
		</ul>
	</section>

	<a class="back-link" href="/">← 返回文章存档</a>
</PageLayout>

<style>
	.page-heading {
		margin-bottom: 2rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}

	.path {
		margin: 0 0 0.35rem;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.path a {
		color: var(--accent);
	}

	.page-heading h1 {
		margin-bottom: 0.25rem;
	}

	.page-heading > p:last-child {
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}

	.post-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-list li {
		padding: 1rem 0;
		border-top: 1px dashed rgb(var(--gray-light));
	}

	.post-list li:last-child {
		border-bottom: 1px dashed rgb(var(--gray-light));
	}

	.post-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}

	.post-title {
		color: rgb(var(--black));
	}

	.post-title:hover {
		color: var(--accent);
	}

	.post-title h2 {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.45;
	}

	.date {
		flex: none;
		margin: 0;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.post-description {
		margin: 0.3rem 0 0;
		color: rgb(var(--gray));
		font-size: 0.875rem;
		line-height: 1.55;
	}

	.back-link {
		display: inline-block;
		margin-top: 2rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}

	@media (max-width: 720px) {
		.post-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.2rem;
		}
	}
</style>
