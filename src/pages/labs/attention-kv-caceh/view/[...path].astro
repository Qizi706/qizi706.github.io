---
import { readFile } from 'node:fs/promises';
import nodePath from 'node:path';
import {
	encodePhase2ArtifactPath,
	phase2LabArtifacts,
	phase2LabBasePath,
	type Phase2LabArtifact,
} from '../../../../data/phase2-lab-artifacts';

export function getStaticPaths() {
	return phase2LabArtifacts.map((file) => ({
		params: { path: file.path },
		props: { file },
	}));
}

interface Props {
	file: Phase2LabArtifact;
}

const { file } = Astro.props;
const sourcePath = nodePath.join(process.cwd(), 'public', 'labs', 'attention-kv-caceh', file.path);
const content = await readFile(sourcePath, 'utf8');
const rawPath = phase2LabBasePath + encodePhase2ArtifactPath(file.path);
const downloadName = nodePath.basename(file.path);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>{file.path} — Phase 2 lab artifact</title>
		<meta name="description" content={'UTF-8 viewer for ' + file.path} />
		<style>
			:root {
				color-scheme: light;
			}

			body {
				color: #000;
				background: #fff;
			}

			a {
				color: #000;
			}

			header {
				display: flex;
				align-items: baseline;
				gap: 1rem;
			}

			h1 {
				font-size: 1.5rem;
			}

			nav {
				margin-left: auto;
				margin-bottom: 1rem;
				white-space: nowrap;
			}

			nav a + a {
				margin-left: 0.75rem;
			}

			main {
				overflow-x: auto;
			}

			pre {
				margin: 0;
				tab-size: 4;
			}
		</style>
	</head>
	<body>
		<header>
			<h1>{file.path}</h1>
			<nav aria-label="Artifact actions">
				<a href={rawPath}>Raw</a>
				<a href={rawPath} download={downloadName}>Download</a>
			</nav>
		</header>
		<main><pre><code>{content}</code></pre></main>
	</body>
</html>
