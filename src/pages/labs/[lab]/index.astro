---
import LabDirectoryListing from '../../../components/LabDirectoryListing.astro';
import {
	collectLabArtifacts,
	discoverLabs,
	getLabArchiveInfo,
	getLabManifest,
	listLabDirectoryEntries,
} from '../../../utils/lab-artifacts.mjs';

export async function getStaticPaths() {
	const labs = await discoverLabs();
	return Promise.all(
		labs.map(async (labName) => ({
			params: { lab: labName },
			props: { labName, manifest: await getLabManifest(labName) },
		})),
	);
}

interface Props {
	labName: string;
	manifest: Awaited<ReturnType<typeof getLabManifest>>;
}

const { labName, manifest } = Astro.props;
const artifacts = await collectLabArtifacts(labName);
const entries = listLabDirectoryEntries(artifacts);
const archive = await getLabArchiveInfo(labName);
const archivePath = `/labs/${archive.filename}?v=${archive.sha256.slice(0, 12)}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>Index of /labs/{labName}/</title>
		<meta name="description" content={manifest.description} />
		<style>
			body {
				margin: 8px;
				color: #111;
				background: #fff;
				font-family: serif;
			}

			h1 {
				font-size: 2rem;
			}

			footer {
				font-size: 0.875rem;
			}
		</style>
	</head>
	<body>
		<h1>Index of /labs/{labName}/</h1>
		<hr />
		<LabDirectoryListing
			{labName}
			{entries}
			parentHref={manifest.parent.href}
			archiveHref={archivePath}
			archiveFilename={archive.filename}
		/>
		<hr />
		<footer>
			<p>
				{manifest.title} artifacts for <a href={manifest.parent.href}>{manifest.parent.label}</a>.
			</p>
			{(manifest.notes ?? []).map((note: string) => <p>{note}</p>)}
		</footer>
	</body>
</html>
