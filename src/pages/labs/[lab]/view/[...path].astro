---
import {
	collectLabArtifactDirectories,
	collectLabArtifacts,
	discoverLabs,
	getLabArtifactRawHref,
	getLabDirectoryHref,
} from '../../../../utils/lab-artifacts.mjs';

export async function getStaticPaths() {
	const paths = [];
	for (const labName of await discoverLabs()) {
		const artifacts = await collectLabArtifacts(labName);
		paths.push(
			...collectLabArtifactDirectories(artifacts).map((directoryPath) => ({
				params: { lab: labName, path: directoryPath },
				props: { destination: getLabDirectoryHref(labName, directoryPath) },
			})),
			...artifacts.map((artifact) => ({
				params: { lab: labName, path: artifact.path },
				props: { destination: getLabArtifactRawHref(labName, artifact.path) },
			})),
		);
	}
	return paths;
}

interface Props {
	destination: string;
}

return Astro.redirect(Astro.props.destination, 301);
---
