---
import { readFile } from 'node:fs/promises';
import path from 'node:path';
import {
	phase1LabArtifacts,
	phase1LabBasePath,
	type Phase1LabArtifact,
} from '../../../../data/phase1-lab-artifacts';

export function getStaticPaths() {
	return phase1LabArtifacts.map((file) => ({
		params: { filename: file.name },
		props: { file },
	}));
}

interface Props {
	file: Phase1LabArtifact;
}

const { file } = Astro.props;
const sourcePath = path.join(
	process.cwd(),
	'public',
	'labs',
	'llm-inference-request-lifecycle',
	file.name,
);
const content = await readFile(sourcePath, 'utf8');
const rawPath = `${phase1LabBasePath}${file.name}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>{file.name} — Phase 1 lab artifact</title>
		<meta name="description" content={`UTF-8 viewer for ${file.name}`} />
		<style>
			:root {
				color-scheme: light dark;
			}

			body {
				margin: 0;
				color: #111827;
				background: #fff;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
			}

			header {
				position: sticky;
				top: 0;
				display: flex;
				padding: 0.75rem 1rem;
				border-bottom: 1px solid #d1d5db;
				background: rgb(255 255 255 / 94%);
				align-items: center;
				gap: 1rem;
				backdrop-filter: blur(8px);
			}

			h1 {
				min-width: 0;
				flex: 1;
				margin: 0;
				overflow: hidden;
				font-size: 1rem;
				text-overflow: ellipsis;
				white-space: nowrap;
			}

			nav {
				display: flex;
				flex: none;
				gap: 0.75rem;
			}

			main {
				max-width: none;
				margin: 0;
				padding: 1rem;
				overflow-x: auto;
			}

			pre {
				margin: 0;
				font: inherit;
				line-height: 1.5;
				tab-size: 4;
			}

			@media (prefers-color-scheme: dark) {
				body {
					color: #e5e7eb;
					background: #111827;
				}

				header {
					border-color: #374151;
					background: rgb(17 24 39 / 94%);
				}
			}
		</style>
	</head>
	<body>
		<header>
			<h1>{file.name}</h1>
			<nav aria-label="Artifact actions">
				<a href={rawPath}>Raw</a>
				<a href={rawPath} download={file.name}>Download</a>
			</nav>
		</header>
		<main><pre><code>{content}</code></pre></main>
	</body>
</html>
