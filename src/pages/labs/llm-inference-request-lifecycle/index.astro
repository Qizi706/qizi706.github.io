---
import {
	phase1LabArtifacts as files,
	phase1LabBasePath as basePath,
} from '../../../data/phase1-lab-artifacts';

const filenameWidth = Math.max(...files.map(({ name }) => name.length)) + 8;
const parentPath = '/blog/llm-inference-request-lifecycle-practice/';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>Index of /labs/llm-inference-request-lifecycle/</title>
		<meta name="description" content="LLM inference request lifecycle phase 1 lab artifacts" />
		<style>
			body {
				margin: 8px;
				color: #111;
				background: #fff;
				font-family: serif;
			}

			h1 {
				font-size: 2rem;
			}

			.directory-listing {
				max-width: 100%;
				overflow-x: auto;
				font-family: monospace;
				line-height: 1.45;
			}

			.entry {
				display: block;
			}

			footer {
				font-size: 0.875rem;
			}
		</style>
	</head>
	<body>
		<h1>Index of /labs/llm-inference-request-lifecycle/</h1>
		<hr />
		<pre
			class="directory-listing"><span class="entry"><a href={parentPath}>../</a></span>{files.map(
				(file) => (
					<span class="entry"><a href={`${basePath}view/${encodeURIComponent(file.name)}/`}>{file.name}</a>{' '.repeat(
						filenameWidth - file.name.length,
					)}{file.modified}{file.size.toString().padStart(20)}</span>
				),
			)}</pre>
		<hr />
		<footer>
			<p>
				Phase 1 artifacts for <a href={parentPath}>本地 LLM 推理服务实验</a>.
			</p>
			<p>File names open a UTF-8 viewer with raw and download links.</p>
			<p>The public installation log contains a sanitized home-directory path.</p>
		</footer>
	</body>
</html>
