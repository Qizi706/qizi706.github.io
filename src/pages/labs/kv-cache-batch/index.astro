---
import LabArchiveDownload from '../../../components/LabArchiveDownload.astro';
import {
	encodeKvCacheBatchArtifactPath,
	kvCacheBatchArtifacts as files,
	kvCacheBatchBasePath as basePath,
} from '../../../data/kv-cache-batch-artifacts';

const filenameWidth = Math.max(...files.map(({ path }) => path.length)) + 8;
const parentPath = '/blog/vllm-inference-performance-lab/';
const archiveFilename = 'kv-cache-batch.tar.gz';
const archivePath = `/labs/${archiveFilename}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="64x64" href="/favicon.ico?v=4" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<title>Index of /labs/kv-cache-batch/</title>
		<meta
			name="description"
			content="Causal Attention, KV Cache, and batched decode phase 2 lab artifacts"
		/>
		<style>
			body {
				margin: 8px;
				color: #111;
				background: #fff;
				font-family: serif;
			}

			h1 {
				font-size: 2rem;
			}

			.directory-listing {
				max-width: 100%;
				overflow-x: auto;
				font-family: monospace;
				line-height: 1.45;
			}

			.entry {
				display: block;
			}

			footer {
				font-size: 0.875rem;
			}
		</style>
	</head>
	<body>
		<h1>Index of /labs/kv-cache-batch/</h1>
		<hr />
		<pre
			class="directory-listing"><span class="entry"><a href={parentPath}>../</a></span><LabArchiveDownload href={archivePath} filename={archiveFilename} />{files.map(
				(file) => (
					<span class="entry"><a href={basePath + 'view/' + encodeKvCacheBatchArtifactPath(file.path) + '/'}>{file.path}</a>{' '.repeat(
						filenameWidth - file.path.length,
					)}{file.modified}{file.size.toString().padStart(20)}</span>
				),
			)}</pre>
		<hr />
		<footer>
			<p>
				Phase 2 artifacts for <a href={parentPath}
					>LLM 推理性能实验：KV Cache、预分配与 Batched Decode</a
				>.
			</p>
			<p>File names open a UTF-8 viewer with raw and download links.</p>
			<p>Generated caches, virtual environments, and hidden repository files are excluded.</p>
		</footer>
	</body>
</html>
