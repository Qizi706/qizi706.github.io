---
import Layout from '../layouts/BlogPost.astro';
import LearningStage from '../components/LearningStage.astro';
import '../styles/global.css';
import { getLabManifest } from '../utils/lab-artifacts.mjs';

const kvCacheLab = await getLabManifest('kv-cache-batch');
const phase2Progress = kvCacheLab.progress;
const phase2Milestone = phase2Progress.milestone;
const currentGate = phase2Progress.current;
const completedGateSummary = phase2Progress.completed
	.map((gate: { id: string; title: string }) => `${gate.id} ${gate.title}`)
	.join(' · ');
const phase2Evidence = phase2Progress.evidence;
---

<Layout
	title="Systems & AI Infrastructure"
	description="系统软件项目、可复现实验、AI Infrastructure 学习路线与 AI 协作原则"
	pubDate={new Date('2026-08-06')}
	updatedDate={new Date('2026-08-25')}
	hideTitleDivider
>
	<section class="profile-brief" aria-label="技术方向与工作方法">
		<div class="section-label">00 / profile</div>
		<p class="profile-summary">
			以系统软件与数据基础设施为主线：已在 xv6 与 BusTub
			中完成虚拟内存、文件系统、缓冲池、并发索引、查询执行与 MVCC
			等核心模块；当前将这些系统能力迁移到单机 LLM Serving，聚焦请求链路、KV Cache、调度与性能工程。
		</p>
		<dl class="profile-ledger">
			<div>
				<dt>focus</dt>
				<dd>AI Infrastructure / Systems</dd>
			</div>
			<div>
				<dt>foundation</dt>
				<dd>OS · Storage Engine · Concurrency</dd>
			</div>
			<div>
				<dt>working set</dt>
				<dd>C · C++ · Python · RISC-V · Linux</dd>
			</div>
			<div>
				<dt>method</dt>
				<dd>implement → benchmark → source trace → write</dd>
			</div>
		</dl>
	</section>

	<section class="about-section" aria-labelledby="projects-title">
		<div class="section-label">01 / implemented systems</div>
		<h2 id="projects-title">系统项目</h2>

		<details class="project" open>
			<summary>
				<span>MIT 6.S081</span>
				<small>RISC-V · xv6 · C · Linux</small>
			</summary>
			<div class="project-body">
				<p class="project-meta">2026.02 — 2026.04 · independent implementation</p>
				<p>
					基于 RISC-V / xv6 扩展内存、进程、Trap
					与文件系统路径，重点验证虚拟内存、异常处理和持久化语义。
				</p>
				<ul>
					<li>实现独立内核页表与用户页表映射机制，掌握 trampoline、trapframe 与页表切换流程。</li>
					<li>基于 page fault 实现 lazy allocation 与 copy-on-write fork，维护物理页引用计数。</li>
					<li>扩展 trap 与 syscall 机制，实现 alarm 系统调用和用户态定时回调。</li>
					<li>实现非抢占式用户级线程库，支持线程创建、上下文保存/恢复与协作式调度。</li>
					<li>扩展 xv6 文件系统，支持三级间接索引、软链接、mmap/munmap 与按需映射回写。</li>
				</ul>
			</div>
		</details>

		<details class="project" open>
			<summary>
				<span>CMU 15-445</span>
				<small>BusTub · C++ · Linux</small>
			</summary>
			<div class="project-body">
				<p class="project-meta">2025.11 — 2025.12 · independent implementation</p>
				<p>
					围绕单机数据库内核完成存储、索引、执行、优化与事务链路，实现可并发访问的 BusTub 核心模块。
				</p>
				<ul>
					<li>
						实现线程安全的 BufferPoolManager，维护 page/frame 映射、pin count、dirty flag
						与换入换出。
					</li>
					<li>实现 LRU-K 页面替换器，并与 Buffer Pool 的 evictable 状态协同工作。</li>
					<li>实现支持并发访问的 B+Tree 索引、节点 split/merge/redistribution 与有序迭代器。</li>
					<li>
						基于 Volcano Iterator 模型实现 Scan、Join、Aggregation、Sort、Limit、Distinct 等算子。
					</li>
					<li>实现规则优化器，将 SeqScan 改写为 IndexScan，将 NestedLoopJoin 改写为 HashJoin。</li>
					<li>基于版本链和 undo log 实现 MVCC，支持快照隔离下的并发读写。</li>
				</ul>
			</div>
		</details>
	</section>

	<section class="about-section" aria-labelledby="learning-title">
		<div class="section-label">02 / learning roadmap</div>
		<h2 id="learning-title">AI Infra 学习路线</h2>

		<LearningStage
			period="2026.07.27 — 2026.08.11"
			title="阶段 1 · LLM Serving 请求链路与基线"
			status="done"
		>
			<div class="quest-line">
				<input
					class="quest-checkbox"
					type="checkbox"
					checked
					disabled
					aria-label="LLM Serving 请求链路与基线已完成"
				/>
				<span>request lifecycle baseline <span class="muted">/ 16 days</span></span>
				<span class="quest-state is-done" aria-hidden="true">[done]</span>
			</div>

			<dl class="phase-ledger" aria-label="阶段一证据摘要">
				<div>
					<dt>scope</dt>
					<dd>single-node · single-request · 4B quantized model</dd>
				</div>
				<div>
					<dt>runtime</dt>
					<dd>Ollama · vLLM Metal</dd>
				</div>
				<div>
					<dt>evidence</dt>
					<dd>2 articles · benchmark script · CSV · raw logs</dd>
				</div>
				<div>
					<dt>boundary</dt>
					<dd>no streaming concurrency or tail-latency claim</dd>
				</div>
			</dl>

			<div class="learning-grid">
				<div>
					<h3>核心问题</h3>
					<ol>
						<li>请求如何经过 API、Tokenizer、Scheduler、Model Runner 与 Backend？</li>
						<li>Prefill、Decode 与 KV Cache 分别承担什么计算和状态？</li>
						<li>输入/输出长度如何改变 Prefill、Decode 与端到端耗时？</li>
						<li>实验结论依赖哪些环境、负载、统计口径和证据边界？</li>
					</ol>
				</div>
				<div>
					<h3>已交付证据</h3>
					<ul>
						<li>完成 Qwen3-4B 的本地推理与 vLLM Metal 服务基线。</li>
						<li>对输入/输出长度进行单变量实验，保留脚本、CSV、响应与日志。</li>
						<li>
							完成<a href="/blog/llm-inference-request-lifecycle/"
								>《LLM 推理系统从请求到返回的完整链路》</a
							>。
						</li>
						<li>
							完成<a href="/blog/llm-inference-request-lifecycle-practice/"
								>《本地 LLM 推理服务实验》</a
							>，显式区分近似指标、严格指标与未验证结论。
						</li>
					</ul>
				</div>
			</div>

			<details class="reading-list">
				<summary>reading queue <span>展开阅读清单</span></summary>
				<div class="reading-columns">
					<div>
						<h3>理解 LLM 和 Transformer</h3>
						<ul>
							<li>
								<a
									href="https://jalammar.github.io/illustrated-transformer/"
									target="_blank"
									rel="noreferrer">The Illustrated Transformer</a
								>
							</li>
							<li>
								<a
									href="https://jalammar.github.io/illustrated-gpt2/"
									target="_blank"
									rel="noreferrer">The Illustrated GPT-2</a
								>
							</li>
						</ul>
						<h3>理解推理和生成</h3>
						<ul>
							<li>
								<a
									href="https://huggingface.co/blog/how-to-generate"
									target="_blank"
									rel="noreferrer">How to generate text</a
								>
							</li>
							<li>
								<a
									href="https://huggingface.co/docs/transformers/main/en/llm_tutorial"
									target="_blank"
									rel="noreferrer">Transformers: Text generation</a
								>
							</li>
						</ul>
					</div>
					<div>
						<h3>理解 KV Cache</h3>
						<ul>
							<li>
								<a
									href="https://huggingface.co/docs/transformers/main/en/cache_explanation"
									target="_blank"
									rel="noreferrer">KV Cache explained</a
								>
							</li>
							<li>
								<a
									href="https://huggingface.co/docs/transformers/main/en/llm_optims"
									target="_blank"
									rel="noreferrer">Optimizing inference</a
								>
							</li>
						</ul>
						<h3>性能与系统</h3>
						<ul>
							<li>
								<a href="https://blog.vllm.ai/2023/06/20/vllm.html" target="_blank" rel="noreferrer"
									>vLLM + PagedAttention</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/latest/design/kernel/paged_attention.html"
									target="_blank"
									rel="noreferrer">Paged Attention</a
								>
							</li>
							<li>
								<a
									href="https://docs.nvidia.com/nim/benchmarking/llm/latest/metrics.html"
									target="_blank"
									rel="noreferrer">LLM Benchmarking Metrics</a
								>
							</li>
						</ul>
					</div>
				</div>
			</details>

			<pre
				class="pipeline"
				aria-label="LLM inference pipeline"><code>prompt
  -&gt; tokenizer
  -&gt; prefill  -&gt;  KV Cache
  -&gt; decode   -&gt;  scheduler / batching
  -&gt; response

constraint: KV Cache consumes GPU memory</code></pre>
		</LearningStage>

		<LearningStage
			period={phase2Milestone.period}
			title={phase2Milestone.title}
			status="active"
			open
		>
			<div class="quest-line">
				<input
					class="quest-checkbox"
					type="checkbox"
					disabled
					aria-label="LLM 推理核心知识与 vLLM 性能实验进行中"
				/>
				<span>core inference + vLLM benchmark <span class="muted">/ 32 days</span></span>
				<span class="quest-state is-active" aria-hidden="true">[active]</span>
			</div>
			<p>{phase2Milestone.goal}</p>

			<dl class="phase-ledger" aria-label="阶段二实验契约">
				<div>
					<dt>current</dt>
					<dd>{currentGate.id} · {currentGate.title}</dd>
				</div>
				<div>
					<dt>completed</dt>
					<dd>{completedGateSummary}</dd>
				</div>
				<div>
					<dt>core route</dt>
					<dd>{phase2Milestone.coreRoute}</dd>
				</div>
				<div>
					<dt>evidence</dt>
					<dd>
						{phase2Evidence.tests} passing tests · {phase2Evidence.rawSamples} raw samples · {
							phase2Evidence.summary
						}
					</dd>
				</div>
				<div>
					<dt>final output</dt>
					<dd>{phase2Milestone.finalArtifact}</dd>
				</div>
			</dl>

			<div class="learning-grid">
				<div>
					<h3>核心问题</h3>
					<ol>
						<li>Transformer 的 Prefill 与 Decode 分别执行什么？</li>
						<li>Attention 为什么需要 KV Cache，它节省了什么又增加了什么？</li>
						<li>Prefill 为什么计算密集，Decode 为什么容易受内存与调度影响？</li>
						<li>Batch Size 怎样改变吞吐与延迟，为什么它在动态 Serving 中不是一个数字？</li>
						<li>Continuous Batching 怎样提高利用率，又引入什么竞争？</li>
						<li>Prefix Caching 复用了什么，为什么主要影响重复 Prefill？</li>
						<li>Speculative Decoding 怎样提出和验证候选，收益取决于什么？</li>
						<li>Chunked Prefill 为什么可能改善 Decode ITL，又会付出什么代价？</li>
						<li>权重、激活、KV Cache、临时 Buffer 与 Runtime 开销怎样组成显存占用？</li>
						<li>输入长度、并发与 Scheduler Budget 怎样共同决定 TTFT、TPOT 和吞吐？</li>
					</ol>
				</div>
				<div>
					<h3>证据进度</h3>
					<ul>
						{
							phase2Progress.completed.map((gate: { id: string; summary: string }) => (
								<li>
									[done] {gate.id} · {gate.summary}
								</li>
							))
						}
						<li>[active] {currentGate.id} · {currentGate.objective}</li>
						<li>
							[pending/core] S0–S4：真实 vLLM 环境、TTFT/TPOT、显存、输入长度、并发与调度预算。
						</li>
						<li>[pending/core] F0：结论矩阵、复现包、闭卷答辩与最终 vLLM 性能文章。</li>
						<li>[optional] {phase2Milestone.advancedRoute}</li>
					</ul>
				</div>
			</div>

			<h3 class="subsection-title">执行窗口</h3>
			<div class="month-plan" aria-label="阶段二学习与验收计划">
				<article>
					<span>08.12 — 08.18 / week 01</span>
					<h4>KV Cache 与 Batch 机制证据 · done</h4>
					<p>完成 Cache 等价性、预分配、Batched Decode、P0 NumPy 语义和 M1 Batch Size Scan。</p>
					<p class="week-gate"><b>evidence</b> 9 tests + 300 length samples + 240 batch samples</p>
				</article>
				<article class="is-current">
					<span>08.19 — 08.25 / week 02</span>
					<h4>完成 A1/A2，启动无 Cache MHA · active</h4>
					<p>{currentGate.id}：{currentGate.objective}</p>
					<p class="week-gate"><b>gate</b> M2 acceptance → S0 snapshot</p>
				</article>
				<article>
					<span>08.26 — 09.01 / week 03</span>
					<h4>关闭 M2，冻结真实 vLLM · pending</h4>
					<p>完成 MHA/GQA 与 KV 容量表，再完成 S0 环境快照和 S1 单并发稳态基线。</p>
					<p class="week-gate"><b>gate</b> M2 capacity table + S0 snapshot + S1 baseline</p>
				</article>
				<article>
					<span>09.02 — 09.08 / week 04</span>
					<h4>输入长度、并发与调度批量 · pending</h4>
					<p>
						完成 S2 Input Length、S3 Client Concurrency 和 S4 Scheduler
						Budget，区分客户端负载、配置上限与实际 Batch。
					</p>
					<p class="week-gate"><b>gate</b> input curves + saturation point + scheduler evidence</p>
				</article>
				<article class="review-window">
					<span>09.09 — 09.12 / review</span>
					<h4>原始阶段产出与闭卷验收</h4>
					<p>重建核心曲线、复测异常、完成十个知识点答辩并交付最终 vLLM 性能文章。</p>
					<p class="week-gate">
						<b>release</b> reproducible bundle + final article + core complete
					</p>
				</article>
			</div>

			<p class="scope-note">
				<span>[scope]</span> 当前只做 {currentGate.id}：{currentGate.objective} M2 通过后立即进入 S0。Speculative
				Decoding、Prefix Caching 与 Chunked Prefill 的基本思想属于核心口述范围；S5/S6 实验、源码追踪、跨环境迁移和分布式并行不阻塞本月交付。
			</p>

			<details class="reading-list">
				<summary>reference set <span>核心材料 / 按需扩展</span></summary>
				<div class="reading-columns">
					<div>
						<h3>core / 机制与系统</h3>
						<ul>
							<li>
								<a href="https://arxiv.org/abs/1706.03762" target="_blank" rel="noreferrer"
									>Attention Is All You Need</a
								>
							</li>
							<li>
								<a href="https://arxiv.org/abs/2309.06180" target="_blank" rel="noreferrer"
									>Efficient Memory Management for LLM Serving with PagedAttention</a
								>
							</li>
							<li>
								<a
									href="https://www.usenix.org/conference/osdi22/presentation/yu"
									target="_blank"
									rel="noreferrer"
									>Orca: A Distributed Serving System for Transformer-Based Generative Models</a
								>
							</li>
							<li>
								<a href="/blog/conjecture-verification-practice/"
									>Speculative Decoding：候选、验证与分布保持</a
								>
							</li>
						</ul>

						<h3>core / 实现与测量</h3>
						<ul>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/configuration/optimization/"
									target="_blank"
									rel="noreferrer">vLLM Optimization and Tuning</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/benchmarking/cli/"
									target="_blank"
									rel="noreferrer">vLLM Benchmark CLI</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/usage/metrics/"
									target="_blank"
									rel="noreferrer">vLLM Production Metrics</a
								>
							</li>
						</ul>
					</div>
					<div>
						<h3>extension / 调度与 Cache</h3>
						<ul>
							<li>
								<a href="https://arxiv.org/abs/2403.02310" target="_blank" rel="noreferrer"
									>Sarathi-Serve: Taming the Throughput-Latency Tradeoff</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/features/automatic_prefix_caching/"
									target="_blank"
									rel="noreferrer">vLLM Automatic Prefix Caching</a
								>
							</li>
						</ul>

						<h3>environment / Backend 边界</h3>
						<ul>
							<li>
								<a
									href="https://docs.vllm.ai/projects/vllm-metal/en/latest/"
									target="_blank"
									rel="noreferrer">vLLM Metal</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/projects/vllm-metal/en/latest/configuration/"
									target="_blank"
									rel="noreferrer">vLLM Metal Configuration</a
								>
							</li>
						</ul>

						<h3>source / vertical slice</h3>
						<ul>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/api/vllm/v1/request/"
									target="_blank"
									rel="noreferrer">Request and RequestStatus</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/api/vllm/config/scheduler/"
									target="_blank"
									rel="noreferrer">Scheduler Configuration</a
								>
							</li>
							<li>
								<a
									href="https://docs.vllm.ai/en/stable/api/vllm/v1/core/kv_cache_coordinator/"
									target="_blank"
									rel="noreferrer">KV Cache Coordinator</a
								>
							</li>
						</ul>
					</div>
				</div>
			</details>

			<pre
				class="pipeline"
				aria-label="LLM serving performance model"><code>load: request_rate != client_concurrency
  -&gt; queue: queue_time / waiting_requests
  -&gt; scheduler: active_sequences + token_budget
  -&gt; prefill / chunked_prefill &lt;-&gt; decode
  -&gt; KV blocks: allocate / reuse / release
  -&gt; client: TTFT / TPOT / ITL / E2E / throughput
  -&gt; server: running / waiting / KV_cache_usage

scope: backend + hardware + model + version + workload</code></pre>

			<p class="stage-gate">
				<strong>核心验收：</strong>闭卷解释十个推理知识点；完成 M2 与 S0–S4，在固定环境中记录 TTFT、
				TPOT、吞吐、显存、输入长度、并发和 Scheduler
				Budget；用客户端与服务端证据解释吞吐—延迟权衡，并完成
				{phase2Milestone.finalArtifact}。S5、S6、R0 与 T0 属于进阶扩展，不阻塞 Core Complete。
			</p>
		</LearningStage>
	</section>

	<section class="about-section principles-section" aria-labelledby="principles-title">
		<div class="section-label">03 / operating principles</div>
		<h2 id="principles-title">学习与 AI 协作原则</h2>

		<p class="principles-lead">
			<strong>不回避 AI，不外包判断。</strong>独立编程用于维护建模、实现、调试与解释能力；AI
			用于扩大代码库探索、验证和工程交付效率。最终结论只由代码、测试、测量与可复现证据确认。
		</p>

		<div class="mode-grid" aria-label="三种 AI 协作模式">
			<article>
				<header>
					<span>M0</span>
					<h3>独立模式</h3>
				</header>
				<p>用于核心机制、第一轮调试与最终解释；AI 不介入问题求解。</p>
				<small>own: model · invariant · implementation</small>
			</article>
			<article>
				<header>
					<span>M1</span>
					<h3>教练模式</h3>
				</header>
