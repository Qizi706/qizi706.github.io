---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import DefinitionGrid from '../../components/DefinitionGrid.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import LabDirectoryListing from '../../components/LabDirectoryListing.astro';
import LearningTaskPanel from '../../components/LearningTaskPanel.astro';
import NoticeBanner from '../../components/NoticeBanner.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import SurfaceCard from '../../components/SurfaceCard.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import {
	collectLabArtifacts,
	getLabArtifactDisplayHref,
	getLabArchiveInfo,
	getLabManifest,
	listLabDirectoryEntries,
} from '../../utils/lab-artifacts.mjs';
import { getDraftPostUrl, getPostUrl } from '../../utils/posts';

interface PhaseArticle {
	id: string;
	role: string;
	status: 'draft' | 'published';
}

interface ResolvedArticle {
	article: PhaseArticle;
	post: CollectionEntry<'blog'>;
}

interface PhaseDocument {
	label: string;
	title: string;
	description: string;
	path: string;
}

const labName = 'kv-cache-batch';
const manifest = await getLabManifest(labName);
const { milestone, preview, completed, current, evidence } = manifest.progress;
const allPosts = await getCollection('blog');
const postById = new Map(allPosts.map((post) => [post.id, post]));
const articles: ResolvedArticle[] = (preview.articles as PhaseArticle[]).map(
	(article: PhaseArticle) => {
		const post = postById.get(article.id);
		if (!post) throw new Error(`Phase 2 article not found: ${article.id}`);
		if ((article.status === 'draft') !== post.data.draft) {
			throw new Error(`Phase 2 article status mismatch: ${article.id}`);
		}
		return { article, post };
	},
);
const draftArticles = articles.filter(({ article }) => article.status === 'draft');
const publishedArticles = articles.filter(({ article }) => article.status === 'published');
const artifacts = await collectLabArtifacts(labName);
const rootEntries = listLabDirectoryEntries(artifacts);
const archive = await getLabArchiveInfo(labName);
const archiveHref = `/labs/${archive.filename}?v=${archive.sha256.slice(0, 12)}`;
const labHref = `/labs/${labName}/`;
const labInstructionsHref = getLabArtifactDisplayHref(labName, 'README.md');
const planHref = getLabArtifactDisplayHref(labName, 'docs/PLAN.md');
const currentDocumentHref = getLabArtifactDisplayHref(labName, current.document);
const labDocuments = (preview.documents as PhaseDocument[]).map((document) => ({
	...document,
	href: getLabArtifactDisplayHref(labName, document.path),
}));
const labArtifactPrefix = `/labs/${labName}/`;
const preferReadingMode = (href: string) =>
	href.startsWith(labArtifactPrefix) && href.endsWith('.md')
		? getLabArtifactDisplayHref(labName, href.slice(labArtifactPrefix.length))
		: href;
const description =
	'阶段 2 的共学入口：查看当前任务、前置阅读、完成记录、实验原始证据、文章草稿与完整 Lab 文件。';
---

<PageLayout
	title="阶段 2 共学记录：LLM 推理核心知识与 vLLM 性能实验"
	{description}
	mainClass="phase2-learning-page"
	noindex
>
	<header class="phase-hero">
		<p class="eyebrow">LINK-ONLY LEARNING LOG · PHASE 02</p>
		<h1>LLM 推理核心知识与 vLLM 性能实验</h1>
		<p class="lead">
			这不是完成后的成果陈列，而是一条可以中途加入的学习路线。你可以看到我现在做到哪里、为什么这样安排，下载同一份
			Lab，并按相同的预测、实现、测量和验收过程跟着做。
		</p>
		<NoticeBanner layout="wrap">
			<strong>[灰度共学]</strong>
			<span>共学页面会随学习进度变化，不出现在主页、文章归档、RSS 或 sitemap。</span>
			<span>未完成的文章草稿仅通过未收录的 <code>/draft</code> 路由预览。</span>
		</NoticeBanner>
		<div class="hero-actions" aria-label="Lab 快捷入口">
			<a class="action-link action-link--primary" href="#lab">进入 Lab</a>
			<a class="action-link" href={currentDocumentHref}>阅读当前工作表</a>
		</div>
	</header>

	<nav class="section-nav" aria-label="阶段共学页目录">
		<a href="#lab">Lab 入口</a>
		<a href="#start">从这里开始</a>
		<a href="#current">当前任务</a>
		<a href="#completed">完成记录</a>
		<a href="#experiments">实验</a>
		<a href="#articles">文章</a>
		<a href="#files">文件</a>
	</nav>

	<section id="lab" class="section-block lab-section">
		<div class="section-heading">
			<p>00 / LAB ENTRY</p>
			<h2>进入 Lab：阅读机制，检查证据</h2>
		</div>

		<SurfaceCard as="article" class="lab-launch" padding="none">
			<div class="lab-launch__main">
				<p class="lab-launch__kicker">CURRENT · {current.id}</p>
				<h3>{manifest.title}</h3>
				<p>{manifest.description}</p>
				<p class="lab-launch__current"><strong>当前目标：</strong>{current.objective}</p>
			</div>
			<div class="lab-launch__actions">
				<a class="action-link action-link--primary" href={labInstructionsHref}>打开实验任务书</a>
				<a class="action-link" href={currentDocumentHref}>填写 {current.id} 工作表</a>
				<a class="action-link" href={planHref}>阅读完整计划</a>
				<a class="action-link" href={labHref}>浏览全部文件</a>
				<a class="text-link" href={archiveHref} download={archive.filename}>
					下载完整 Lab · {archive.filename}
				</a>
			</div>
		</SurfaceCard>

		<div class="document-heading">
			<div>
				<h3>实验文档 · 阅读模式</h3>
				<p>说明、工作表和结论按排版后的 Markdown 阅读；代码与原始数据从文件目录直接打开。</p>
			</div>
			<span>{labDocuments.length} DOCS</span>
		</div>
		<DefinitionGrid as="div" class="document-grid" variant="elevated" collapseAt="720">
			{
				labDocuments.map((document) => (
					<div>
						<a href={document.href}>
							<span>{document.label}</span>
							<strong>{document.title}</strong>
							<p>{document.description}</p>
							<small>{document.path} · READ →</small>
						</a>
					</div>
				))
			}
		</DefinitionGrid>
	</section>

	<section id="start" class="section-block">
		<div class="section-heading">
			<p>01 / ONBOARDING</p>
			<h2>从这里开始</h2>
		</div>

		<DefinitionGrid class="milestone-ledger" variant="elevated" collapseAt="720">
			<div>
				<dt>period</dt>
				<dd>{milestone.period}</dd>
			</div>
			<div>
				<dt>goal</dt>
				<dd>{milestone.goal}</dd>
			</div>
			<div>
				<dt>core route</dt>
				<dd>{milestone.coreRoute}</dd>
			</div>
			<div>
				<dt>final output</dt>
				<dd>{milestone.finalArtifact}</dd>
			</div>
		</DefinitionGrid>

		<ol class="follow-steps">
			<li>
				<strong>先看路线，不先抄代码。</strong>
				打开<a href={planHref}>阶段 2 学习执行手册</a>，确认核心路线、当前 Gate 和停止条件。
			</li>
			<li>
				<strong>拿到相同材料。</strong>
				<a href={archiveHref} download={archive.filename}>下载完整 Lab</a
				>，或从本页末尾逐层浏览目录；原始数据、测试、记录和代码都在其中。
			</li>
			<li>
				<strong>从当前任务跟做。</strong>
				先写 Prediction，再完成当天前置阅读和正确性测试，不直接从我的结果倒推答案。
			</li>
			<li>
				<strong>用证据决定下一步。</strong>
				只有 Acceptance 通过才前进；结果不同就保存环境、原始数据和反例，而不是修改结论迎合本文。
			</li>
		</ol>
	</section>

	<LearningTaskPanel task={current} documentHref={currentDocumentHref} eyebrow="02 / CURRENT" />

	<section id="completed" class="section-block">
		<div class="section-heading">
			<p>03 / COMPLETED</p>
			<h2>已完成任务</h2>
		</div>
		<p class="evidence-line">
			当前累计 {evidence.tests} 项回归测试、{evidence.rawSamples} 条原始计时样本；{
				evidence.summary
			}。
		</p>
		<ol class="record-list">
			{
				completed.map((task: { id: string; period: string; title: string; summary: string }) => (
					<li>
						<div class="record-meta">
							<span>{task.id}</span>
							<time>{task.period}</time>
						</div>
						<h3>{task.title}</h3>
						<p>{task.summary}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section id="experiments" class="section-block">
		<div class="section-heading">
			<p>04 / EXPERIMENTS</p>
			<h2>已经可以复查的实验</h2>
		</div>
		<div class="experiment-grid">
			{
				preview.experiments.map(
					(experiment: { id: string; title: string; summary: string; href: string }) => (
						<SurfaceCard as="article">
							<span>{experiment.id} · evidence</span>
							<h3>{experiment.title}</h3>
							<p>{experiment.summary}</p>
							<a href={preferReadingMode(experiment.href)}>查看记录与原始文件 →</a>
						</SurfaceCard>
					),
				)
			}
		</div>
	</section>

	<section id="articles" class="section-block">
		<div class="section-heading">
			<p>05 / WRITING</p>
			<h2>文章：先读机制，再读证据</h2>
		</div>

		<h3 class="group-title">本地草稿</h3>
		{
			import.meta.env.DEV ? (
				<ul class="article-list">
					{draftArticles.map(({ article, post }) => (
						<li>
							<div>
								<StatusBadge tone="draft">DRAFT · DEV ONLY</StatusBadge>
								<a href={getDraftPostUrl(post)}>{post.data.title}</a>
							</div>
							<p>{article.role}</p>
							<small>
								更新于 <FormattedDate date={post.data.updatedDate ?? post.data.pubDate} />
							</small>
						</li>
					))}
				</ul>
			) : (
				<NoticeBanner tone="draft">
					文章草稿不在此处展示，可通过未收录的 <a href="/draft/">草稿预览</a>访问。
				</NoticeBanner>
			)
		}

		<h3 class="group-title">已发布文章</h3>
		<ul class="article-list">
			{
				publishedArticles.map(({ article, post }) => (
					<li>
						<div>
							<StatusBadge tone="published">PUBLISHED</StatusBadge>
							<a href={getPostUrl(post)}>{post.data.title}</a>
						</div>
						<p>{article.role}</p>
						<small>
							发布于 <FormattedDate date={post.data.pubDate} />
						</small>
					</li>
				))
			}
		</ul>
	</section>

	<section id="files" class="section-block">
		<div class="section-heading">
			<p>06 / FILES</p>
			<h2>完整 Lab 目录</h2>
		</div>
		<p>
			当前公开 {artifacts.length} 个可审计文件。目录一次只展开一层：先进入 <code>src/</code>、<code
				>tests/</code
			>、
			<code>docs/</code> 或 <code>results/</code>，再查看其中内容；不会在这里铺开所有文件名。
		</p>
		<div class="file-listing">
			<LabDirectoryListing {labName} entries={rootEntries} parentHref={labHref} />
		</div>
	</section>

	<footer class="page-boundary">
		<p>
			<strong>如何理解进度：</strong>文章写清楚只代表 Explained；测试通过代表
			Implemented；原始数据可重建才代表 Measured。
		</p>
		<p>
			当前核心进度是 M2-B，真实 vLLM 的 S0–S4
			尚未开始。这里展示计划和草稿，不把未来任务提前写成完成。
		</p>
	</footer>
</PageLayout>

<style>
	:global(.page-frame.phase2-learning-page) {
		max-width: 68rem;
		color: #1f2937;
		font-family: var(--font-body);
	}

	.phase-hero {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #cbd5e1;
	}

	.eyebrow,
	.section-heading p {
		margin: 0;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
	}

	.phase-hero h1 {
		margin: 0.5rem 0 0.75rem;
		font-size: clamp(1.7rem, 4vw, 2.5rem);
		line-height: 1.25;
	}

	.lead {
		max-width: 52rem;
		margin: 0;
		color: #475569;
		font-size: 1rem;
		line-height: 1.8;
	}

	.hero-actions,
	.lab-launch__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.hero-actions {
		margin-top: 1rem;
	}

	.action-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.35rem;
		padding: 0.45rem 0.8rem;
		border: 1px solid #cbd5e1;
		border-radius: var(--card-radius);
		color: #334155;
		background: #fff;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-decoration: none;
	}

	.action-link:hover,
	.action-link:focus-visible {
		border-color: #64748b;
		color: #0f172a;
	}

	.action-link--primary,
	.action-link--primary:hover,
	.action-link--primary:focus-visible {
		border-color: #0f172a;
		color: #fff;
		background: #0f172a;
	}

	.section-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid #e2e8f0;
		font-family: var(--font-mono);
		font-size: 0.78rem;
	}

	.section-block {
		padding: 2rem 0;
		border-bottom: 1px solid #e2e8f0;
		scroll-margin-top: 4.5rem;
	}

	.section-heading {
		margin-bottom: 1rem;
	}

	.section-heading h2 {
		margin: 0.25rem 0 0;
		font-size: 1.35rem;
	}

	.lab-section {
		padding-top: 1.5rem;
	}

	.lab-launch {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.38fr);
		border: 1px solid #cbd5e1;
		background: linear-gradient(135deg, #f8fafc 0%, #fff 60%, #f1f5f9 100%);
	}

	.lab-launch__main,
	.lab-launch__actions {
		padding: 1.1rem;
	}

	.lab-launch__main {
		border-right: 1px dashed #cbd5e1;
	}

	.lab-launch__main h3 {
		margin: 0.3rem 0 0.5rem;
		font-size: clamp(1.2rem, 3vw, 1.6rem);
	}

	.lab-launch__main > p {
		max-width: 42rem;
		margin: 0;
		color: #475569;
		line-height: 1.65;
	}

	.lab-launch__main .lab-launch__kicker {
		color: #2563eb;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.lab-launch__main .lab-launch__current {
		margin-top: 0.85rem;
		padding-top: 0.75rem;
		border-top: 1px dashed #cbd5e1;
		color: #334155;
		font-size: 0.9rem;
	}

	.lab-launch__actions {
		align-content: center;
		align-items: stretch;
		flex-direction: column;
		justify-content: center;
	}

	.lab-launch__actions .action-link {
		width: 100%;
	}

	.text-link {
		margin-top: 0.15rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		text-align: center;
	}

	.document-heading {
		display: flex;
		align-items: start;
		justify-content: space-between;
		gap: 1rem;
		margin: 1.5rem 0 0.75rem;
	}

	.document-heading h3,
	.document-heading p {
		margin: 0;
	}

	.document-heading h3 {
		font-size: 1rem;
	}

	.document-heading p {
		max-width: 48rem;
		margin-top: 0.3rem;
		color: #64748b;
		font-size: 0.85rem;
		line-height: 1.6;
	}

	.document-heading > span {
		flex: none;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.document-grid {
		margin: 0;
	}

	.document-grid a {
		display: block;
		height: 100%;
		color: inherit;
		text-decoration: none;
	}

	.document-grid a:hover strong,
	.document-grid a:focus-visible strong {
		color: var(--accent);
	}

	.document-grid span,
	.document-grid small {
		display: block;
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.document-grid strong {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.95rem;
	}

	.document-grid p {
		margin: 0.35rem 0 0.75rem;
		color: #475569;
		font-size: 0.82rem;
		line-height: 1.55;
	}

	.milestone-ledger dt,
	.record-meta,
	.experiment-grid :global(article > span) {
		color: #64748b;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.milestone-ledger dd {
		margin: 0.3rem 0 0;
		line-height: 1.6;
	}

	.follow-steps {
		margin: 1.25rem 0 0;
		padding-left: 1.4rem;
		line-height: 1.75;
	}

	.follow-steps li {
		margin: 0.55rem 0;
	}

	.experiment-grid :global(p),
	.article-list p,
	.section-block > p,
	.page-boundary p {
		line-height: 1.65;
	}

	.experiment-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.8rem;
		margin-top: 1rem;
	}

	.experiment-grid :global(h3) {
		margin: 0 0 0.55rem;
		font-size: 1rem;
	}

	.evidence-line {
		padding: 0.7rem 0.8rem;
		border-radius: var(--card-radius);
		background: #f1f5f9;
	}

	.record-list,
	.article-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.record-list li,
	.article-list li {
		padding: 0.9rem 0;
		border-top: 1px dashed #cbd5e1;
	}

	.record-list li:last-child,
	.article-list li:last-child {
		border-bottom: 1px dashed #cbd5e1;
	}

	.record-meta {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.record-list h3 {
		margin: 0.25rem 0;
		font-size: 1rem;
	}

	.record-list p,
	.article-list p {
		margin: 0.25rem 0;
		color: #475569;
	}

	.experiment-grid :global(article a) {
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.group-title {
		margin: 1.25rem 0 0.5rem;
		font-size: 1rem;
	}

	.article-list li > div {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.75rem;
	}

	.article-list li > div > a {
		font-weight: 600;
	}

	.article-list small {
		color: #64748b;
		font-family: var(--font-mono);
	}

	.file-listing {
		margin-top: 1rem;
	}

	.page-boundary {
		padding: 1.25rem 0 0;
		color: #475569;
		font-size: 0.85rem;
	}

	.page-boundary p {
		margin: 0.35rem 0;
	}

	@media (max-width: 720px) {
		.hero-actions .action-link {
			flex: 1 1 12rem;
		}

		.lab-launch {
			grid-template-columns: 1fr;
		}

		.lab-launch__main {
			border-right: 0;
			border-bottom: 1px dashed #cbd5e1;
		}

		.experiment-grid {
			grid-template-columns: 1fr;
		}

		.record-meta {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.15rem;
		}
	}
</style>
