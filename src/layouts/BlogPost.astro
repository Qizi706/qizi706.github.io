---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type BlogData = CollectionEntry<'blog'>['data'];
type Props = Pick<BlogData, 'title' | 'description' | 'pubDate' | 'updatedDate' | 'heroImage'> & {
	categories?: BlogData['categories'];
	tags?: BlogData['tags'];
	draft?: BlogData['draft'];
	hideTitleDivider?: boolean;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	draft = false,
	categories = [],
	tags = [],
	hideTitleDivider = false,
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} noindex={draft} />
		<style>
			main {
				display: block;
				flex: none;
				width: min(calc(100% - 2rem), var(--content-width));
				min-height: 100vh;
				margin: 0 auto;
				padding: 0;
			}
			article {
				padding: 2.5rem;
				border: 0 solid var(--frame-border);
				border-radius: 0;
				background: var(--content-background);
				box-shadow: none;
			}
			.hero-image {
				margin: 0 auto 1.5rem;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border: 0;
				border-radius: 0;
				background: transparent;
				box-shadow: none;
			}
			.prose {
				padding: 0;
				color: rgb(var(--prose-body));
			}
			.title {
				margin-bottom: 1.5rem;
				padding: 0 0 1rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				text-align: left;
			}
			.title h1 {
				margin: 0.5rem 0 0.75rem;
				font-size: 1.5rem;
				line-height: 2rem;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.8125rem;
			}
			.last-updated-on {
				display: inline;
				margin-left: 0.5rem;
			}
			.taxonomy {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin: 0.6rem 0 0;
			}
			.taxonomy span {
				padding: 0.05rem 0.4rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: var(--card-radius);
				font-family: var(--font-mono);
				font-size: 0.7rem;
				line-height: 1.6;
			}
			.draft-preview {
				display: flex;
				flex-wrap: wrap;
				justify-content: space-between;
				gap: 0.35rem 1rem;
				margin: 0 0 1rem;
				padding: 0.65rem 0.8rem;
				border: 1px dashed rgb(var(--gray-light));
				border-radius: var(--card-radius);
				color: rgb(var(--gray));
				background: rgb(var(--gray-light) / 18%);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				line-height: 1.5;
			}
			.category {
				color: var(--accent);
			}
			.tag {
				color: rgb(var(--gray));
			}
			.title hr {
				display: none;
			}
			.title--no-divider {
				padding-bottom: 0;
				border-bottom: 0;
			}
			@media (min-width: 768px) {
				article {
					border-width: 1px;
					box-shadow: var(--wiki-frame-shadow);
				}
			}
			@media (max-width: 720px) {
				main {
					width: 100%;
					margin-bottom: 0;
					padding: 0;
				}
				article {
					padding: 1.5rem 1rem 2rem;
					border-right: 0;
					border-left: 0;
					border-radius: 0;
					box-shadow: none;
				}
				.title h1 {
					font-size: 1.5rem;
				}
				.last-updated-on {
					display: block;
					margin-left: 0;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					{
						draft && (
							<aside class="draft-preview" aria-label="草稿预览提示">
								<span>[DRAFT PREVIEW] 不进入正式文章归档、RSS 或 sitemap。</span>
								<a href="/draft/">返回草稿列表</a>
							</aside>
						)
					}
					<div class:list={['title', { 'title--no-divider': hideTitleDivider }]}>
						<div class="date">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="last-updated-on">
										更新于 <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{
							(categories.length > 0 || tags.length > 0) && (
								<div class="taxonomy">
									{categories.map((category) => (
										<span class="category">~/ {category}</span>
									))}
									{tags.map((tag) => (
										<span class="tag">#{tag}</span>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
