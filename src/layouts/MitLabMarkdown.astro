---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html>
	<head>
		<meta charset="utf-8" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Times New Roman', Times, serif;
	}

	.easy {
		color: #00cc00;
	}

	.moderate {
		color: #0066ff;
	}

	.hard {
		color: #ff3300;
	}

	div.required,
	div.challenge,
	div.question,
	div.warning,
	div.prereq {
		width: 80%;
		margin: 1em auto;
		padding-right: 1em;
		padding-left: 1em;
		background-color: #e0e0ff;
	}

	div.required .header,
	div.question .header {
		font-weight: bold;
	}

	div.challenge .header {
		font-style: italic;
	}

	div.required,
	div.question {
		border: 1px solid #c0c0ff;
		background-color: #e0e0ff;
	}

	div.challenge,
	div.warning {
		border: 1px solid #ffc0c0;
		background-color: #ffe0e0;
	}

	div.prereq {
		border: 1px solid #ffc0c0;
		background-color: #ffefd5;
	}

	kbd {
		color: #007700;
		font-family: monospace;
		font-weight: bold;
	}
</style>
