{
	"name": "astro-site",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:status": "astro dev status",
		"dev:logs": "astro dev logs",
		"dev:stop": "astro dev stop",
		"predev": "npm run labs:publish",
		"labs:check": "node scripts/check-labs.mjs",
		"labs:publish": "node scripts/publish-labs.mjs",
		"labs:sync": "npm run labs:publish",
		"labs:archive": "npm run labs:publish",
		"prebuild": "npm run labs:check && npm run labs:publish",
		"build": "astro build",
		"check": "npm run labs:check && npm run labs:publish && astro check",
		"preview": "astro preview",
		"astro": "astro",
		"migrate:hexo": "node scripts/migrate-hexo.mjs"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.2",
		"@astrojs/mdx": "^7.0.5",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@fontsource/fira-mono": "^5.3.0",
		"@fontsource/kalam": "^5.3.0",
		"astro": "^7.1.6",
		"katex": "0.16.22",
		"rehype-katex": "^7.0.1",
		"remark-math": "^6.0.0",
		"sharp": "^0.35.0",
		"typescript": "^6.0.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"prettier": "3.9.6",
		"prettier-plugin-astro": "0.14.1"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true
	}
}
